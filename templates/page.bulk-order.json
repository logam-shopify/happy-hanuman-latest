    "faq": {
      "type": "logam-english-faq",
      "blocks": {
        "faq-1": {
          "type": "faq",
          "settings": {
            "question": "What is the minimum order?",
            "answer": "<p>120 books. Choose 120, 500, 1,000, 5,000 or 10,000 books. The bigger the pack, the less each book costs, for your whole order.</p>"
          }
        },
        "faq-2": {
          "type": "faq",
          "settings": {
            "question": "Can I see one before I order in bulk?",
            "answer": "<p>Yes. Get one free demo book with your brand on the back. You pay only ₹69 for delivery, and the ₹69 is adjusted when you order 120 or more. One demo per buyer.</p>"
          }
        },
        "faq-3": {
          "type": "faq",
          "settings": {
            "question": "When do I pay?",
            "answer": "<p>Half when you order and half before dispatch. Pay by UPI, Google Pay, PhonePe, Paytm, debit or credit card, or net banking.</p>"
          }
        },
        "faq-4": {
          "type": "faq",
          "settings": {
            "question": "Will I see my design before printing?",
            "answer": "<p>Yes. We WhatsApp you the back cover design within 24 hours. We print only after you approve it.</p>"
          }
        },
        "faq-5": {
          "type": "faq",
          "settings": {
            "question": "How long does it take?",
            "answer": "<p>Printing takes 7–10 working days after you approve the design. Delivery is free across India and takes 3–5 days.</p>"
          }
        },
        "faq-6": {
          "type": "faq",
          "settings": {
            "question": "What goes on the back cover?",
            "answer": "<p>Your logo or photo, a Hanuman Chalisa line with its meaning, your slogan, your phone number and your address or website. The Ram mark and the Mission 100 Million seal stay as they are.</p>"
          }
        },
        "faq-7": {
          "type": "faq",
          "settings": {
            "question": "Is GST included? Can I get a GST invoice?",
            "answer": "<p>Yes, all prices include GST. For a GST invoice, add your GSTIN in the order form.</p>"
          }
        },
        "faq-8": {
          "type": "faq",
          "settings": {
            "question": "Which logo files can I upload?",
            "answer": "<p>JPG, PNG or PDF, up to 25 MB. No file handy? Tick “I’ll send my logo on WhatsApp” and send it after ordering.</p>"
          }
        },
        "faq-9": {
          "type": "faq",
          "settings": {
            "question": "Can I print a photo instead of a logo?",
            "answer": "<p>Yes. Upload a photo, for example a family photo for a wedding, or a loved one’s photo in their memory.</p>"
          }
        },
        "faq-10": {
          "type": "faq",
          "settings": {
            "question": "Can I order books in different languages?",
            "answer": "<p>One language per order. For another language, place a second order.</p>"
          }
        },
        "faq-11": {
          "type": "faq",
          "settings": {
            "question": "What if I leave the slogan empty?",
            "answer": "<p>No problem. We print the back cover without a slogan.</p>"
          }
        }
      },
