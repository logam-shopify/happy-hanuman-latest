    "logam_gujarati_faq_kPLzAX": {
      "type": "logam-gujarati-faq",
      "blocks": {
        "faq_7pNdEt": {
          "type": "faq",
          "settings": {
            "question": "શું મને ગુજરાતી એડિશન જ મળશે?",
            "answer": "<p>હા. આ પેજ પરથી ગુજરાતી એડિશન મળે છે. English કે हिन्दी જોઈએ? ઉપર એડિશન બદલો. ચિત્રો અને બાકી બધું ત્રણેયમાં સરખું છે.</p>"
          }
        },
        "faq_43L7hh": {
          "type": "faq",
          "settings": {
            "question": "શું કલરિંગ શીટ્સ સાથે આવે છે?",
            "answer": "<p>ના. આ પુસ્તકમાં સ્ટેપ 1 થી 4 છે. આર્ટ થેરાપી કલરિંગ શીટ્સ (સ્ટેપ 5) 43 શીટ્સનો અલગ સેટ છે, ₹999નો. પુસ્તક સાથે લેશો તો કુલ રકમ પર 10% છૂટ મળશે.</p>"
          }
        },
        "faq_GGXfny": {
          "type": "faq",
          "settings": {
            "question": "આ પુસ્તક કોના માટે છે?",
            "answer": "<p>બાળકો અને મોટાઓ, બંને માટે: પરિવાર, માતા-પિતા, ટીચર અને હનુમાન ભક્તો.</p>"
          }
        },
        "faq_hhyeUW": {
          "type": "faq",
          "settings": {
            "question": "પેમેન્ટ કેવી રીતે કરું?",
            "answer": "<p>UPI, Google Pay, PhonePe, Paytm, ડેબિટ કે ક્રેડિટ કાર્ડ (Visa, Mastercard, RuPay), અથવા નેટ બેન્કિંગથી. અથવા હમણાં ફક્ત 20% ચૂકવો અને બાકીના પુસ્તક મળે ત્યારે.</p>"
          }
        },
        "faq_c96ez7": {
          "type": "faq",
          "settings": {
            "question": "પુસ્તક ક્યારે પહોંચશે?",
            "answer": "<p>આખા ભારતમાં 3 થી 5 વર્કિંગ દિવસમાં, ફ્રી શિપિંગ સાથે. પુસ્તક મોકલતાં જ તમને ઇમેઇલ પર ટ્રેકિંગ નંબર મળશે.</p>"
          }
        },
        "faq_eaBwVN": {
          "type": "faq",
          "settings": {
            "question": "પુસ્તક ખરાબ હાલતમાં કે ખોટી ભાષામાં આવે તો?",
            "answer": "<p>ડિલિવરીના 7 દિવસમાં +91 82381 88824 પર WhatsAppથી ફોટો મોકલો, અમે નવું પુસ્તક મોકલી આપીશું.</p>"
          }
        },
        "faq_twJdPB": {
          "type": "faq",
          "settings": {
            "question": "શું આ ગિફ્ટ તરીકે મોકલી શકાય?",
            "answer": "<p>હા. ચેકઆઉટ વખતે જેને મોકલવું હોય તેનું નામ અને સરનામું લખો, અમે સીધું તેમને પહોંચાડીશું.</p>"
          }
        }
      },
