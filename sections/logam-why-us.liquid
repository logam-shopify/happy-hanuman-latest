{%- liquid
  assign s = section.settings
-%}

<div class="lg-why" style="--lg-why-bg: {{ s.bg_color }}; --lg-why-text: {{ s.text_color }}; --lg-why-accent: {{ s.accent_color }}; --lg-why-pt: {{ s.padding_top }}px; --lg-why-pb: {{ s.padding_bottom }}px;">
  <div class="lg-why__inner">
    {%- if s.heading != blank -%}
      <h2 class="lg-why__heading">{{ s.heading | escape }}</h2>
    {%- endif -%}
    {%- if s.description != blank -%}
      <p class="lg-why__sub">{{ s.description | escape }}</p>
    {%- endif -%}

    <ul class="lg-why__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="lg-why__card" {{ block.shopify_attributes }}>
          {%- if block.settings.icon_image != blank or block.settings.icon != 'none' -%}
            <span class="lg-why__icon" aria-hidden="true">
              {%- if block.settings.icon_image != blank -%}
                {{ block.settings.icon_image | image_url: width: 64 | image_tag: loading: 'lazy', alt: '' }}
              {%- else -%}
                {%- case block.settings.icon -%}
                  {%- when 'temple' -%}
                    <svg viewBox="0 0 24 24"><path d="M12 2.5v2M10.5 4.5h3l1 3h-5z"/><path d="M8.5 7.5h7l1 4h-9z"/><path d="M5.5 11.5h13v2h-13zM6.5 13.5V21M17.5 13.5V21M4 21h16"/><path d="M10 21v-4a2 2 0 0 1 4 0v4"/></svg>
                  {%- when 'mind' -%}
                    <svg viewBox="0 0 24 24"><path d="M9 21v-3.2a7 7 0 1 1 9.5-3.4l1.3 2.4-2.3.7V20a1.5 1.5 0 0 1-1.5 1.5H14"/><circle cx="12.5" cy="10" r="2"/><path d="M12.5 6.5v1.5M12.5 12v1.5M9 10h1.5M14.5 10H16M10 7.5l1 1M14 11.5l1 1M10 12.5l1-1M14 8.5l1-1"/></svg>
                  {%- when 'book' -%}
                    <svg viewBox="0 0 24 24"><path d="M12 6.5C10.3 5.2 7.9 4.6 4 4.6v13c3.9 0 6.3.6 8 1.9 1.7-1.3 4.1-1.9 8-1.9v-13c-3.9 0-6.3.6-8 1.9z"/><path d="M12 6.5v13M15 9.5l1.5-1.5 1.5 1.5v4"/></svg>
                  {%- when 'gift' -%}
                    <svg viewBox="0 0 24 24"><rect x="4" y="9" width="16" height="11" rx="1.5"/><path d="M4 13h16M12 9v11"/><path d="M12 9c-1.5-3-5-3.3-5-1.2C7 9 9.5 9 12 9zM12 9c1.5-3 5-3.3 5-1.2C17 9 14.5 9 12 9z"/></svg>
                  {%- when 'heart' -%}
                    <svg viewBox="0 0 24 24"><path d="M12 20s-7.5-4.4-7.5-10A4.3 4.3 0 0 1 12 7.3 4.3 4.3 0 0 1 19.5 10c0 5.6-7.5 10-7.5 10z"/></svg>
                  {%- when 'star' -%}
                    <svg viewBox="0 0 24 24"><path d="M12 3.2l2.7 5.6 6.1.8-4.5 4.2 1.1 6.1L12 17l-5.4 2.9 1.1-6.1-4.5-4.2 6.1-.8z"/></svg>
                {%- endcase -%}
              {%- endif -%}
            </span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="lg-why__title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="lg-why__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .lg-why {
    background: var(--lg-why-bg);
    color: var(--lg-why-text);
    padding: var(--lg-why-pt) 20px var(--lg-why-pb);
  }
  #shopify-section-{{ section.id }} .lg-why__inner { max-width: 1320px; margin: 0 auto; }
  #shopify-section-{{ section.id }} .lg-why__heading {
    max-width: 600px;
    margin: 0 auto 18px;
    text-align: center;
    font-size: clamp(28px, 3.3vw, 44px);
    font-weight: 700;
    line-height: 1.35;
    color: var(--lg-why-text);
  }
  #shopify-section-{{ section.id }} .lg-why__sub { max-width: 740px; margin: 0 auto 52px; text-align: center; font-size: 16px; line-height: 1.5; opacity: .85; }

  #shopify-section-{{ section.id }} .lg-why__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 26px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #shopify-section-{{ section.id }} .lg-why__card {
    padding: 28px 28px 30px;
    border: 1px solid #ebebeb;
    border-radius: 26px;
    background: #fff;
  }
  #shopify-section-{{ section.id }} .lg-why__icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    margin-bottom: 14px;
    border-radius: 12px;
    background: #fff;
    color: var(--lg-why-accent);
    box-shadow: 0 3px 10px rgba(217, 105, 46, .16);
  }
  #shopify-section-{{ section.id }} .lg-why__icon svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  #shopify-section-{{ section.id }} .lg-why__icon img { width: 24px; height: 24px; object-fit: contain; }
  #shopify-section-{{ section.id }} .lg-why__title { margin: 0; font-size: 20px; font-weight: 700; line-height: 1.3; color: var(--lg-why-text); }
  #shopify-section-{{ section.id }} .lg-why__text { margin: 12px 0 0; font-size: 14px; line-height: 1.5; opacity: .85; }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .lg-why__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .lg-why { padding-left: 16px; padding-right: 16px; }
    #shopify-section-{{ section.id }} .lg-why__heading { font-size: 22px; max-width: 300px; margin-bottom: 10px; }
    #shopify-section-{{ section.id }} .lg-why__sub { font-size: 13px; margin-bottom: 24px; }
    #shopify-section-{{ section.id }} .lg-why__grid { gap: 14px; }
    #shopify-section-{{ section.id }} .lg-why__card { padding: 16px 14px 20px; border-radius: 22px; }
    #shopify-section-{{ section.id }} .lg-why__icon { width: 38px; height: 38px; margin-bottom: 12px; border-radius: 10px; }
    #shopify-section-{{ section.id }} .lg-why__icon svg { width: 20px; height: 20px; }
    #shopify-section-{{ section.id }} .lg-why__title { font-size: 14px; }
    #shopify-section-{{ section.id }} .lg-why__text { margin-top: 4px; font-size: 12px; line-height: 1.4; }
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .lg-why { padding-top: {{ section.settings.padding_top_mobile }}px; padding-bottom: {{ section.settings.padding_bottom_mobile }}px; }
  }
</style>

{% schema %}
{
  "name": "Logam Why Us",
  "tag": "section",
  "class": "section--logam-why-us",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Parents Choose Happy Hanuman" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Designed by childhood educators and Vedic scholars to replace passive screen time with soulful bonding." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#14201A" },
    { "type": "color", "id": "accent_color", "label": "Icon colour", "default": "#D9692E" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top — desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom — desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top — mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom — mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "temple",
          "options": [
            { "value": "temple", "label": "Temple" },
            { "value": "mind", "label": "Mind" },
            { "value": "book", "label": "Book" },
            { "value": "gift", "label": "Gift" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" },
            { "value": "none", "label": "None" }
          ]
        },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon", "info": "Replaces the icon above." },
        { "type": "text", "id": "title", "label": "Title", "default": "Rooted in Authenticity" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logam Why Us",
      "blocks": [
        { "type": "reason", "settings": { "icon": "temple", "title": "Rooted in Authenticity", "text": "Honors sacred texts without religious dogma. A celebration of timeless wisdom, humility, and unwavering loyalty that suits modern diverse households." } },
        { "type": "reason", "settings": { "icon": "mind", "title": "Emotional Resilience", "text": "Gives children a calm psychological anchor during times of anxiety, fear of failure, or loneliness. Instills the belief that strength comes from within." } },
        { "type": "reason", "settings": { "icon": "book", "title": "Soulful Bedtime Ritual", "text": "Short, beautifully illustrated sections make daily 15-minute readings deeply fulfilling for both parents and children, fostering lifelong memories." } },
        { "type": "reason", "settings": { "icon": "gift", "title": "Heirloom Keepsake", "text": "Thick archival grade paper, smyth-sewn binding, and heavy cloth-textured hardcover meant to survive childhood and be passed down lovingly." } }
      ]
    }
  ]
}
{% endschema %}
