{%- liquid
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.image_mobile | default: section.settings.image
  assign alt = section.settings.alt | default: desktop_image.alt | default: shop.name

  if section.settings.priority
    assign loading = 'eager'
    assign priority = 'high'
  else
    assign loading = 'lazy'
    assign priority = 'auto'
  endif
-%}

{%- style -%}
  #logam-image-{{ section.id }} {
    padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
  }
  #logam-image-{{ section.id }} .logam-image__inner {
    max-width: {% if section.settings.full_width %}none{% else %}1280px{% endif %};
    margin: 0 auto;
    /* Phones always keep a side gutter — edge to edge only kicks in on desktop. */
    padding: 0 {{ section.settings.padding_side_mobile }}px;
  }
  #logam-image-{{ section.id }} .logam-image__media {
    display: block;
    border-radius: {{ section.settings.radius }}px;
    overflow: hidden;
    line-height: 0;
  }
  #logam-image-{{ section.id }} .logam-image__media img {
    display: block;
    width: 100%;
    height: auto;
  }
  #logam-image-{{ section.id }} .logam-image__placeholder svg {
    display: block;
    width: 100%;
    height: auto;
    background: #f1f1f1;
  }
  @media (min-width: 750px) {
    #logam-image-{{ section.id }} {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
    #logam-image-{{ section.id }} .logam-image__inner {
      padding: 0 {% if section.settings.full_width %}0{% else %}16px{% endif %};
    }
  }
{%- endstyle -%}

<section id="logam-image-{{ section.id }}" class="logam-image">
  <div class="logam-image__inner">
    {%- capture media -%}
      {%- if desktop_image != blank -%}
        {%- comment -%}
          Native <picture>: the browser picks one source and downloads only that
          one, so the phone never pays for the desktop crop.
        {%- endcomment -%}
        <picture>
          {%- if section.settings.image_mobile != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ mobile_image | image_url: width: 450 }} 450w,
                {{ mobile_image | image_url: width: 750 }} 750w,
                {{ mobile_image | image_url: width: 1100 }} 1100w
              "
              sizes="100vw"
              width="{{ mobile_image.width }}"
              height="{{ mobile_image.height }}"
            >
          {%- endif -%}
          {{
            desktop_image
            | image_url: width: 1800
            | image_tag:
              widths: '750, 1100, 1500, 1800',
              sizes: '100vw',
              width: desktop_image.width,
              height: desktop_image.height,
              loading: loading,
              fetchpriority: priority,
              decoding: 'async',
              alt: alt
          }}
        </picture>
      {%- else -%}
        <div class="logam-image__placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        </div>
      {%- endif -%}
    {%- endcapture -%}

    {%- if section.settings.link != blank -%}
      <a class="logam-image__media" href="{{ section.settings.link }}">{{ media }}</a>
    {%- else -%}
      <div class="logam-image__media">{{ media }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Logam Image",
  "tag": "section",
  "class": "logam-image-banner-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Shown under 750px. Falls back to the desktop image." },
    { "type": "text", "id": "alt", "label": "Alt text", "info": "Describes the image for screen readers. Defaults to the image's own alt text." },
    { "type": "url", "id": "link", "label": "Link", "info": "Optional. Makes the whole banner clickable." },

    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true, "info": "Edge to edge. Turn off to keep the banner inside the page container." },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "padding_side_mobile", "label": "Side gutter (mobile)", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 12, "info": "Kept even when Full width is on, so the banner never touches the screen edge on phones." },
    { "type": "checkbox", "id": "priority", "label": "Load immediately", "default": true, "info": "Turn off if this banner sits well below the fold." },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top (mobile)", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom (mobile)", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16 }
  ],
  "presets": [{ "name": "Logam Image" }]
}
{% endschema %}
