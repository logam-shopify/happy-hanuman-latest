{%- liquid
  assign s = section.settings
  assign tel = s.phone | remove: ' ' | remove: '-'
-%}

<div class="lg-faq" style="--lg-faq-bg: {{ s.bg_color }}; --lg-faq-text: {{ s.text_color }}; --lg-faq-accent: {{ s.accent_color }}; --lg-faq-pt: {{ s.padding_top }}px; --lg-faq-pb: {{ s.padding_bottom }}px; --lg-faq-pt-m: {{ s.padding_top_mobile }}px; --lg-faq-pb-m: {{ s.padding_bottom_mobile }}px;">
  <div class="lg-faq__inner">
    {%- if s.heading != blank -%}
      <h2 class="lg-faq__heading">{{ s.heading | escape }}</h2>
    {%- endif -%}
    {%- if s.description != blank -%}
      <p class="lg-faq__sub">{{ s.description | escape }}</p>
    {%- endif -%}

    <div class="lg-faq__list">
      {%- for block in section.blocks -%}
        <details class="lg-faq__item" {{ block.shopify_attributes }}{% if forloop.first and s.open_first %} open{% endif %}>
          <summary class="lg-faq__q">
            <span>{{ block.settings.question | escape }}</span>
            <span class="lg-faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="lg-faq__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>

    {%- if s.help_title != blank -%}
      <div class="lg-faq__help">
        <span class="lg-faq__help-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3.5" y="13.5" width="4" height="6" rx="1.6"/><rect x="16.5" y="13.5" width="4" height="6" rx="1.6"/></svg>
        </span>
        <div class="lg-faq__help-text">
          <p class="lg-faq__help-title">{{ s.help_title | escape }}</p>
          {%- if s.help_text != blank -%}<p class="lg-faq__help-sub">{{ s.help_text | escape }}</p>{%- endif -%}
        </div>
        {%- if s.phone != blank -%}
          <a class="lg-faq__call" href="tel:{{ tel }}">{{ s.call_label | escape }} {{ s.phone | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .lg-faq {
    background: var(--lg-faq-bg);
    color: var(--lg-faq-text);
    padding: var(--lg-faq-pt) 20px var(--lg-faq-pb);
  }
  #shopify-section-{{ section.id }} .lg-faq__inner { max-width: 800px; margin: 0 auto; }
  #shopify-section-{{ section.id }} .lg-faq__heading {
    margin: 0 0 10px;
    text-align: center;
    font-size: clamp(26px, 3.2vw, 40px);
    font-weight: 700;
    line-height: 1.25;
    color: var(--lg-faq-text);
  }
  #shopify-section-{{ section.id }} .lg-faq__sub { margin: 0 0 32px; text-align: center; font-size: 15px; line-height: 1.5; opacity: .8; }

  #shopify-section-{{ section.id }} .lg-faq__list { display: grid; gap: 10px; }
  #shopify-section-{{ section.id }} .lg-faq__item {
    border: 1px solid #f0d9c8;
    border-radius: 14px;
    background: #fff;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .lg-faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 15px 18px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    cursor: pointer;
    list-style: none;
  }
  #shopify-section-{{ section.id }} .lg-faq__q::-webkit-details-marker { display: none; }
  #shopify-section-{{ section.id }} .lg-faq__q:focus-visible { outline: 2px solid var(--lg-faq-accent); outline-offset: -2px; border-radius: 14px; }
  #shopify-section-{{ section.id }} .lg-faq__icon { position: relative; flex: 0 0 12px; height: 12px; }
  #shopify-section-{{ section.id }} .lg-faq__icon::before,
  #shopify-section-{{ section.id }} .lg-faq__icon::after {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 12px;
    height: 1.5px;
    margin-top: -.75px;
    background: var(--lg-faq-accent);
    transition: transform .2s ease;
  }
  #shopify-section-{{ section.id }} .lg-faq__icon::after { transform: rotate(90deg); }
  #shopify-section-{{ section.id }} .lg-faq__item[open] .lg-faq__icon::after { transform: rotate(0deg); }
  #shopify-section-{{ section.id }} .lg-faq__a { padding: 0 18px 16px; font-size: 14px; line-height: 1.6; opacity: .85; }
  #shopify-section-{{ section.id }} .lg-faq__a p { margin: 0; }
  #shopify-section-{{ section.id }} .lg-faq__a p + p { margin-top: 8px; }

  #shopify-section-{{ section.id }} .lg-faq__help {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 44px;
    padding: 14px 16px;
    border-radius: 14px;
    background: #fff;
  }
  #shopify-section-{{ section.id }} .lg-faq__help-icon {
    flex: 0 0 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #fbe7da;
    color: var(--lg-faq-accent);
  }
  #shopify-section-{{ section.id }} .lg-faq__help-icon svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  #shopify-section-{{ section.id }} .lg-faq__help-text { flex: 1; min-width: 0; }
  #shopify-section-{{ section.id }} .lg-faq__help-title { margin: 0; font-size: 18px; font-weight: 500; line-height: 1.3; }
  #shopify-section-{{ section.id }} .lg-faq__help-sub { margin: 2px 0 0; font-size: 11px; opacity: .75; }
  #shopify-section-{{ section.id }} .lg-faq__call {
    flex: none;
    padding: 9px 16px;
    border-radius: 8px;
    background: #14261d;
    color: #fff;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .03em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .lg-faq__call:hover { background: #000; color: #fff; }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .lg-faq { padding: var(--lg-faq-pt-m) 16px var(--lg-faq-pb-m); }
    #shopify-section-{{ section.id }} .lg-faq__heading { font-size: 24px; }
    #shopify-section-{{ section.id }} .lg-faq__sub { font-size: 13px; margin-bottom: 20px; }
    #shopify-section-{{ section.id }} .lg-faq__item { border-color: #ebe6e1; border-radius: 12px; }
    #shopify-section-{{ section.id }} .lg-faq__q { padding: 14px 16px; font-size: 14px; }
    #shopify-section-{{ section.id }} .lg-faq__icon { flex-basis: 10px; height: 8px; }
    #shopify-section-{{ section.id }} .lg-faq__icon::before {
      top: 0;
      width: 0;
      height: 0;
      margin: 0;
      border-left: 5px solid transparent;
      border-right: 5px solid transparent;
      border-top: 8px solid #9c9c9c;
      background: none;
    }
    #shopify-section-{{ section.id }} .lg-faq__icon::after { display: none; }
    #shopify-section-{{ section.id }} .lg-faq__item[open] .lg-faq__icon::before { transform: rotate(180deg); }
    #shopify-section-{{ section.id }} .lg-faq__a { padding: 0 16px 14px; font-size: 13px; }

    #shopify-section-{{ section.id }} .lg-faq__help {
      flex-wrap: wrap;
      gap: 12px 14px;
      margin-top: 24px;
      padding: 18px 14px;
      border-radius: 12px;
      background: linear-gradient(135deg, #1c1a19, #2a2624);
      color: #fff;
    }
    #shopify-section-{{ section.id }} .lg-faq__help-icon { flex-basis: 30px; height: 30px; background: #4a3016; color: #f0e6dc; border: 1px solid #8a5a2b; }
    #shopify-section-{{ section.id }} .lg-faq__help-title { font-size: 15px; font-weight: 700; }
    #shopify-section-{{ section.id }} .lg-faq__help-sub { font-size: 12px; opacity: .7; }
    #shopify-section-{{ section.id }} .lg-faq__call {
      width: 100%;
      padding: 12px 14px;
      text-align: center;
      background: var(--lg-faq-accent);
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0;
      text-transform: none;
    }
    #shopify-section-{{ section.id }} .lg-faq__call:hover { background: var(--lg-faq-accent); filter: brightness(.95); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .lg-faq__icon::before,
    #shopify-section-{{ section.id }} .lg-faq__icon::after { transition: none; }
  }
</style>

{% schema %}
{
  "name": "Logam FAQ",
  "tag": "section",
  "class": "section--logam-faq",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Got Questions? We’re Here." },
    { "type": "text", "id": "description", "label": "Description", "default": "Everything you need to know about editions, delivery, and gifting." },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": false },
    { "type": "header", "content": "Help bar" },
    { "type": "text", "id": "help_title", "label": "Title", "default": "Need assistance with your order?", "info": "Leave blank to hide the help bar." },
    { "type": "text", "id": "help_text", "label": "Text", "default": "Our devotional support team in Gujarat is happy to assist." },
    { "type": "text", "id": "call_label", "label": "Button label", "default": "Call" },
    { "type": "text", "id": "phone", "label": "Phone number", "default": "+91 82381 88824" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FDF3EC" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#14201A" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#D9692E" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top — desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom — desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top — mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom — mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "In which languages is the book available?" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    { "name": "Logam FAQ", "blocks": [ { "type": "question" } ] }
  ]
}
{% endschema %}
