{%- liquid
  assign s = section.settings
-%}

<section
  class="hh-lang"
  style="--hh-lang-bg: {{ s.bg_color }}; --hh-lang-text: {{ s.text_color }}; --hh-lang-muted: {{ s.muted_color }}; --hh-lang-accent: {{ s.accent_color }}; --hh-lang-pt: {{ s.padding_top }}px; --hh-lang-pb: {{ s.padding_bottom }}px;"
>
  <div class="hh-lang__inner">
    {%- if s.heading != blank -%}
      <h2 class="hh-lang__heading">{{ s.heading | escape }}</h2>
    {%- endif -%}
    {%- if s.subheading != blank -%}
      <p class="hh-lang__sub">{{ s.subheading | escape }}</p>
    {%- endif -%}

    <div class="hh-lang__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll = collections[block.settings.collection]
          assign img = block.settings.image | default: coll.image
        -%}
        <a
          class="hh-lang__card"
          href="{{ block.settings.link | default: coll.url | default: '#' }}"
          lang="{{ block.settings.lang_code | default: 'en' }}"
          {{ block.shopify_attributes }}
        >
          <div class="hh-lang__media">
            {%- if img != blank -%}
              {{ img | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(max-width: 749px) 80vw, 300px', alt: block.settings.native_label }}
            {%- endif -%}
          </div>
          <span class="hh-lang__native">{{ block.settings.native_label | escape }}</span>
          {%- if block.settings.description != blank -%}
            <span class="hh-lang__desc">{{ block.settings.description | escape }}</span>
          {%- endif -%}
          {%- if block.settings.cta_label != blank -%}
            <span class="hh-lang__cta" lang="en">{{ block.settings.cta_label | escape }} &rarr;</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .hh-lang {
    background: var(--hh-lang-bg);
    color: var(--hh-lang-text);
    padding: var(--hh-lang-pt) 20px var(--hh-lang-pb);
  }
  .hh-lang__inner { max-width: 1100px; margin: 0 auto; }
  .hh-lang__heading {
    margin: 0 0 16px;
    max-width: 480px;
    font-size: clamp(26px, 3vw, 36px);
    line-height: 1.35;
    font-weight: 700;
    color: var(--hh-lang-text);
  }
  .hh-lang__sub {
    margin: 0 0 40px;
    max-width: 560px;
    font-size: 14px;
    line-height: 1.5;
  }
  .hh-lang__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 310px));
    justify-content: center;
    gap: 22px;
  }
  .hh-lang__card {
    display: flex;
    flex-direction: column;
    padding: 16px 16px 20px;
    border: 1px solid #ececec;
    border-radius: 22px;
    background: #fff;
    color: var(--hh-lang-text);
    text-decoration: none;
    transition: box-shadow .18s ease;
  }
  .hh-lang__card:hover,
  .hh-lang__card:focus-visible { color: var(--hh-lang-text); box-shadow: 0 10px 24px rgba(0, 0, 0, .08); }
  .hh-lang__media {
    aspect-ratio: 275 / 165;
    margin-bottom: 14px;
    border-radius: 10px;
    background: #e8e6e2;
    overflow: hidden;
  }
  .hh-lang__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hh-lang__native { font-size: 22px; line-height: 1.3; }
  .hh-lang__desc { margin-top: 6px; font-size: 14px; line-height: 1.55; color: var(--hh-lang-muted); }
  .hh-lang__cta {
    margin-top: auto;
    padding-top: 22px;
    font-size: 10px;
    letter-spacing: .02em;
    text-transform: uppercase;
    color: var(--hh-lang-accent);
  }
  @media screen and (max-width: 749px) {
    .hh-lang { padding-left: 0; padding-right: 0; }
    .hh-lang__heading,
    .hh-lang__sub { margin-left: auto; margin-right: auto; padding: 0 20px; text-align: center; }
    .hh-lang__heading { font-size: 22px; max-width: 320px; margin-bottom: 10px; }
    .hh-lang__sub { font-size: 12px; margin-bottom: 22px; }
    .hh-lang__grid {
      display: grid;
      grid-auto-flow: column;
      grid-template-columns: none;
      grid-auto-columns: 76%;
      justify-content: start;
      gap: 16px;
      width: 100%;
      padding: 0 20px 6px;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      scroll-padding: 0 20px;
      scrollbar-width: none;
    }
    .hh-lang__grid::-webkit-scrollbar { display: none; }
    .hh-lang__card,
    .hh-lang__card:hover,
    .hh-lang__card:focus-visible { box-shadow: none !important; }
    .hh-lang__card { min-width: 0; scroll-snap-align: start; padding: 10px 10px 14px; border-radius: 18px; }
    .hh-lang__desc { font-size: 12px; color: var(--hh-lang-text); }
    .hh-lang__cta { padding-top: 14px; }
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .hh-lang { padding-top: {{ section.settings.padding_top_mobile }}px; padding-bottom: {{ section.settings.padding_bottom_mobile }}px; }
  }
</style>

{% schema %}
{
  "name": "Logam Shop by Language",
  "tag": "section",
  "class": "shopify-section--hh-lang",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose the Language That Feels Like Home" },
    { "type": "textarea", "id": "subheading", "label": "Sub-heading", "default": "The complete Happy Hanuman therapy edition, lovingly translated and printed in English, Gujarati, and Hindi with identical fine archival bindings." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1A1A1A" },
    { "type": "color", "id": "muted_color", "label": "Description", "default": "#555555" },
    { "type": "color", "id": "accent_color", "label": "Link", "default": "#E8630A" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top — desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom — desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top — mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom — mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "language",
      "name": "Language",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Falls back to the collection image." },
        { "type": "text", "id": "native_label", "label": "Label (native script)", "default": "English" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "cta_label", "label": "Link label", "default": "Explore English edition" },
        { "type": "text", "id": "lang_code", "label": "Language code", "default": "en", "info": "e.g. en, gu, hi." },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Link override", "info": "Leave blank to link to the collection." }
      ]
    }
  ],
  "presets": [
    { "name": "Logam Shop by Language", "blocks": [ { "type": "language" } ] }
  ]
}
{% endschema %}
