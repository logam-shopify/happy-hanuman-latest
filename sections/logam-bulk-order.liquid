{%- comment -%}
  Bulk order / free demo order form (design: "Buy more, save more" + "Make it yours" + bk-cart drawer).
  Page type "Bulk order": price tiers, quantity, live back-cover preview, 50% advance.
  Page type "Free demo": one book with the buyer's brand for the delivery charge.
  On submit: details (and the logo file) go to the Google Sheet webhook, then into the real cart
  (line item properties) and the drawer opens with Razorpay Magic Checkout's standard checkout button.
  Without a product the form only sends the details to the sheet ("lead" mode).
  Behaviour: assets/logam-bulk-order.js. Visitor source (UTM): assets/logam-utm.js.
{%- endcomment -%}
{%- render 'logam-hindi-assets' -%}
{{ 'logam-cart.css' | asset_url | stylesheet_tag }}
{{ 'logam-bulk-order.css' | asset_url | stylesheet_tag }}
<script src="{{ 'logam-utm.js' | asset_url }}" defer></script>
<script src="{{ 'logam-bulk-order.js' | asset_url }}" defer></script>
{%- liquid
  assign s = section.settings
  assign sx_b = section.blocks | where: 'type', 'steps' | first
  assign sx = sx_b.settings
  assign fx_b = section.blocks | where: 'type', 'fields' | first
  assign fx = fx_b.settings
  assign mx_b = section.blocks | where: 'type', 'messages' | first
  assign mx = mx_b.settings
  assign dx_b = section.blocks | where: 'type', 'drawer' | first
  assign dx = dx_b.settings
  assign is_bulk = true
  if s.mode == 'demo'
    assign is_bulk = false
  endif
  assign tiers = section.blocks | where: 'type', 'tier'
  assign langs = section.blocks | where: 'type', 'language'
  assign first_lang = langs.first
  assign min_qty = tiers.first.settings.min_qty | default: 120
  assign unit = tiers.first.settings.price | default: 40
  assign total = min_qty | times: unit
  assign pct = s.advance_percent | default: 50
  assign now_amt = total | times: pct | divided_by: 100.0 | round
  assign rest_amt = total | minus: now_amt
  if is_bulk
    assign product = s.product
  else
    assign product = s.demo_product
  endif
  assign step_n = 0
-%}
{%- capture v_qty -%}{% render 'logam-bulk-inr', rupees: min_qty, symbol: '' %}{%- endcapture -%}
{%- capture v_total -%}{% render 'logam-bulk-inr', rupees: total %}{%- endcapture -%}
{%- capture v_now -%}{% render 'logam-bulk-inr', rupees: now_amt %}{%- endcapture -%}
{%- capture v_rest -%}{% render 'logam-bulk-inr', rupees: rest_amt %}{%- endcapture -%}
{%- capture demo_price -%}
  {%- if s.demo_product != blank -%}{% render 'logam-bulk-inr', paise: s.demo_product.price %}{%- else -%}{{ s.demo_price_text }}{%- endif -%}
{%- endcapture -%}
{%- capture b_qty -%}<span data-lb-bind="qty">{{ v_qty }}</span>{%- endcapture -%}
{%- capture b_unit -%}<span data-lb-bind="unit">{{ unit }}</span>{%- endcapture -%}
{%- capture b_total -%}<span data-lb-bind="total">{{ v_total }}</span>{%- endcapture -%}
{%- capture b_now -%}<span data-lb-bind="now">{{ v_now }}</span>{%- endcapture -%}
{%- capture b_rest -%}<span data-lb-bind="rest">{{ v_rest }}</span>{%- endcapture -%}
{%- style -%}
  #lh-{{ section.id }} { --lh-bg: {{ s.bg }}; --lh-pt-m: {{ s.pt_m }}px; --lh-pb-m: {{ s.pb_m }}px; --lh-pt: {{ s.pt }}px; --lh-pb: {{ s.pb }}px; }
{%- endstyle -%}
<section id="lh-{{ section.id }}" class="lh lb-order lb-order--{{ s.mode }}" data-lb-order data-section="{{ section.id }}">
  <span id="{{ s.anchor | default: 'order' | handleize }}" class="lb-order__anchor"></span>
  <div class="lh__in">

    {%- if is_bulk and s.show_tiers and tiers.size > 0 -%}
      <div class="lb-tiers">
        <div class="lb-tiers__head">
          {%- if s.tiers_title != blank -%}<h2 class="lh-title lb-tiers__title">{{ s.tiers_title }}</h2>{%- endif -%}
          {%- if s.tiers_side != blank -%}<span class="lb-tiers__side">{{ s.tiers_side }}</span>{%- endif -%}
        </div>
        <div class="lb-tiers__list">
          {%- for t in tiers -%}
            {%- liquid
              assign next_i = forloop.index
              assign next = tiers[next_i]
              assign save = tiers.first.settings.price | minus: t.settings.price
            -%}
            {%- capture label -%}
              {%- if t.settings.label != blank -%}{{ t.settings.label }}
              {%- else -%}{% render 'logam-bulk-inr', rupees: t.settings.min_qty, symbol: '' %} {{ s.books_word }}{%- endif -%}
            {%- endcapture -%}
            <button type="button" class="lb-tier{% if forloop.first %} is-active{% endif %}" data-lb-tier="{{ t.settings.min_qty }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" {{ t.shopify_attributes }}>
              <span class="lb-tier__range">{{ label }}</span>
              <span class="lb-tier__price">₹{{ t.settings.price }}</span>
              <span class="lb-tier__badge{% if forloop.first %} is-first{% endif %}">{% if forloop.first %}{{ s.tier_first_badge }}{% else %}{{ s.tier_save_badge | replace: '[amount]', save }}{% endif %}</span>
            </button>
          {%- endfor -%}
        </div>
        {%- if s.tiers_note != blank -%}<p class="lb-tiers__note">{{ s.tiers_note }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- render 'logam-hindi-heading', eyebrow: s.eyebrow, title: s.title, sub: s.sub -%}

    <form class="lb-order__grid" data-lb-form novalidate>
      <input type="text" name="lb_website" class="lb-hp" tabindex="-1" autocomplete="off" aria-hidden="true" data-lb-hp>
      <div class="lb-order__main">

        {%- assign step_n = step_n | plus: 1 -%}
        <div class="lb-card">
          <div class="lb-card__head"><span class="lb-card__num" aria-hidden="true">{{ step_n }}</span><div><h3>{{ sx.lang_title }}</h3>{%- if sx.lang_sub != blank -%}<p>{{ sx.lang_sub }}</p>{%- endif -%}</div></div>
          <div class="lb-langs" role="group" aria-label="{{ sx.lang_title | escape }}">
            {%- for l in langs -%}
              <button type="button" class="lb-lang{% if forloop.first %} is-active{% endif %}" data-lb-lang="{{ l.settings.code }}" lang="{{ l.settings.code }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" {{ l.shopify_attributes }}>{{ l.settings.label }}</button>
            {%- endfor -%}
          </div>
          {%- if sx.lang_note != blank -%}<p class="lb-help">{{ sx.lang_note }}</p>{%- endif -%}
        </div>

        {%- if is_bulk -%}
          {%- assign step_n = step_n | plus: 1 -%}
          <div class="lb-card">
            <div class="lb-card__head"><span class="lb-card__num" aria-hidden="true">{{ step_n }}</span><div><h3>{{ sx.qty_title }}</h3>{%- if sx.qty_sub != blank -%}<p>{{ sx.qty_sub }}</p>{%- endif -%}</div></div>
            <div class="lb-qty">
              <div class="lb-qty__count">{{ b_qty }} {{ s.books_word }}</div>
              <div class="lb-qty__sum"><div class="lb-qty__total">{{ b_total }}</div><div class="lb-qty__unit">{{ sx.qty_unit | replace: '[unit]', b_unit }}</div></div>
            </div>
            <div class="lb-presets" role="group" aria-label="{{ sx.qty_title | escape }}">
              {%- for t in tiers -%}
                <button type="button" class="lb-preset{% if forloop.first %} is-active{% endif %}" data-lb-set="{{ t.settings.min_qty }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{% render 'logam-bulk-inr', rupees: t.settings.min_qty, symbol: '' %}</button>
              {%- endfor -%}
            </div>
            {%- if tiers.size > 1 -%}
              {%- liquid
                assign t2 = tiers[1]
                assign more = t2.settings.min_qty | minus: min_qty
              -%}
              {%- capture more_txt -%}{% render 'logam-bulk-inr', rupees: more, symbol: '' %}{%- endcapture -%}
              {%- capture jump_txt -%}{% render 'logam-bulk-inr', rupees: t2.settings.min_qty, symbol: '' %}{%- endcapture -%}
              <div class="lb-nudge" data-lb-nudge>
                <span class="lb-nudge__chip" data-lb-nudge-chip>₹{{ t2.settings.price }}</span>
                <span class="lb-nudge__text"><span data-lb-nudge-text>{{ sx.nudge_text | replace: '[n]', more_txt | replace: '[price]', t2.settings.price }}</span> <button type="button" class="lb-nudge__jump" data-lb-jump>{{ sx.nudge_jump | replace: '[qty]', jump_txt }}</button></span>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- assign step_n = step_n | plus: 1 -%}
        <div class="lb-card">
          <div class="lb-card__head"><span class="lb-card__num" aria-hidden="true">{{ step_n }}</span><div><h3>{{ sx.cover_title }}</h3>{%- if sx.cover_sub != blank -%}<p>{{ sx.cover_sub }}</p>{%- endif -%}</div></div>
          <div class="lb-order__slot" data-lb-slot="mobile">
            <div class="lb-order__cover" data-lb-cover-main>
              {%- render 'logam-bulk-cover', s: sx, chalisa: first_lang.settings.chalisa, lang: first_lang.settings.code -%}
              {%- if sx.cover_note != blank -%}<p class="lb-help lb-help--center">{{ sx.cover_note }}</p>{%- endif -%}
            </div>
          </div>

          <label class="lb-field">
            <span class="lb-field__label">{{ fx.brand_label }}<span class="lb-req" aria-hidden="true"> *</span></span>
            <input type="text" maxlength="40" autocomplete="organization" placeholder="{{ fx.brand_placeholder | escape }}" data-lb-f="brand" aria-describedby="lb-err-brand-{{ section.id }}" required>
          </label>
          <p class="lb-err" id="lb-err-brand-{{ section.id }}" data-lb-err="brand" hidden>{{ fx.brand_error }}</p>

          <label class="lb-field">
            <span class="lb-field__label">{{ fx.slogan_label }}<span class="lb-opt"> {{ fx.optional_word }}</span></span>
            <input type="text" maxlength="60" placeholder="{{ fx.slogan_placeholder | escape }}" data-lb-f="slogan">
          </label>
          {%- if fx.slogan_help != blank -%}<p class="lb-help">{{ fx.slogan_help }}</p>{%- endif -%}

          <label class="lb-field">
            <span class="lb-field__label">{{ fx.phone_label }}<span class="lb-req" aria-hidden="true"> *</span></span>
            <input type="tel" inputmode="tel" maxlength="16" autocomplete="tel" placeholder="{{ fx.phone_placeholder | escape }}" data-lb-f="phone" aria-describedby="lb-err-phone-{{ section.id }}" required>
          </label>
          <p class="lb-err" id="lb-err-phone-{{ section.id }}" data-lb-err="phone" hidden>{{ fx.phone_error }}</p>

          <label class="lb-field">
            <span class="lb-field__label">{{ fx.address_label }}<span class="lb-opt"> {{ fx.optional_word }}</span></span>
            <input type="text" maxlength="60" autocomplete="street-address" placeholder="{{ fx.address_placeholder | escape }}" data-lb-f="address">
          </label>

          <div class="lb-field">
            <span class="lb-field__label" id="lb-logo-{{ section.id }}">{{ fx.logo_label }}<span class="lb-req" aria-hidden="true"> *</span></span>
            <label class="lb-drop" data-lb-drop>
              <span class="lb-drop__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V4.5"/><path d="M7.5 9L12 4.5 16.5 9"/><path d="M4.5 15v3.5a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V15"/></svg></span>
              <span class="lb-drop__txt"><span class="lb-drop__name" data-lb-filename>{{ fx.upload_title }}</span><span class="lb-drop__meta" data-lb-filemeta>{{ fx.upload_meta | replace: '[mb]', fx.max_mb }}</span></span>
              <span class="lb-drop__btn" data-lb-choose>{{ fx.upload_button }}</span>
              <input type="file" accept=".jpg,.jpeg,.png,.pdf,image/jpeg,image/png,application/pdf" aria-labelledby="lb-logo-{{ section.id }}" aria-describedby="lb-err-logo-{{ section.id }}" data-lb-file>
            </label>
            <label class="lb-check"><input type="checkbox" data-lb-later><span>{{ fx.later_label }}</span></label>
            {%- if fx.logo_help != blank -%}<p class="lb-help">{{ fx.logo_help }}</p>{%- endif -%}
            <p class="lb-err" id="lb-err-logo-{{ section.id }}" data-lb-err="logo" hidden>{{ fx.logo_error }}</p>
          </div>

          {%- if fx.show_gstin -%}
            <label class="lb-field">
              <span class="lb-field__label">{{ fx.gstin_label }}<span class="lb-opt"> {{ fx.optional_word }}</span></span>
              <input type="text" maxlength="15" autocapitalize="characters" placeholder="{{ fx.gstin_placeholder | escape }}" data-lb-f="gstin" class="lb-upper">
            </label>
          {%- endif -%}

          <label class="lb-field">
            <span class="lb-field__label">{{ fx.notes_label }}<span class="lb-opt"> {{ fx.optional_word }}</span></span>
            <textarea rows="3" maxlength="300" placeholder="{{ fx.notes_placeholder | escape }}" data-lb-f="notes"></textarea>
          </label>
        </div>
      </div>

      <div class="lb-order__side">
        <div class="lb-order__slot" data-lb-slot="desktop">
          {%- if sx.side_label != blank -%}<p class="lb-order__side-label">{{ sx.side_label }}</p>{%- endif -%}
        </div>

        {%- if is_bulk -%}
          <div class="lb-sum">
            <div class="lb-sum__rows">
              <div class="lb-sum__row"><span>{{ mx.sum_books | replace: '[qty]', b_qty | replace: '[unit]', b_unit }}</span><b>{{ b_total }}</b></div>
              <div class="lb-sum__row"><span>{{ mx.sum_delivery_label }}</span><b class="is-green">{{ mx.sum_delivery_value }}</b></div>
              <div class="lb-sum__row"><span>{{ mx.sum_gst_label }}</span><b>{{ mx.sum_gst_value }}</b></div>
            </div>
            {%- if pct < 100 -%}
              <div class="lb-sum__pay">
                <span class="lb-sum__pct">{{ pct }}%</span>
                <div><div class="lb-sum__title">{{ mx.advance_title | replace: '[now]', b_now }}</div><div class="lb-sum__text">{{ mx.advance_text | replace: '[rest]', b_rest }}</div></div>
              </div>
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="lb-sum">
            <div class="lb-sum__rows">
              <div class="lb-sum__row"><span>{{ mx.demo_line }}</span><span class="lb-nowrap"><s>{{ mx.demo_was }}</s> <b class="is-green">{{ mx.demo_free }}</b></span></div>
              <div class="lb-sum__row"><span>{{ mx.sum_delivery_label }}</span><b>{{ demo_price }}</b></div>
            </div>
            <div class="lb-sum__pay lb-sum__pay--green">
              <div><div class="lb-sum__title">{{ mx.demo_pay_title | replace: '[demo_price]', demo_price }}</div><div class="lb-sum__text">{{ mx.demo_pay_text }}</div></div>
              {%- if mx.demo_badge != blank -%}<span class="lb-sum__badge">{{ mx.demo_badge }}</span>{%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <div class="lb-done" data-lb-done role="status" hidden>
          <p class="lb-done__title">{{ mx.done_title }}</p>
          <p class="lb-done__text">{{ mx.done_text }}</p>
          {%- if s.whatsapp != blank -%}<a class="lh-btn lh-btn--outline lh-btn--full" data-lb-wa href="https://wa.me/{{ s.whatsapp | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener">{{ mx.done_whatsapp }}</a>{%- endif -%}
        </div>

        {%- liquid
          if product != blank
            assign main_label = s.cta_label
          else
            assign main_label = s.lead_cta_label
          endif
        -%}
        <button type="button" class="lh-btn lh-btn--primary lh-btn--full lb-order__cta" data-lb-submit="{{ s.mode }}" data-lb-main>{{ main_label | replace: '[total]', b_total | replace: '[now]', b_now | replace: '[demo_price]', demo_price }}</button>
        {%- if is_bulk and s.demo_button_label != blank -%}
          <button type="button" class="lh-btn lh-btn--outline lh-btn--full lb-order__alt" data-lb-submit="demo">{{ s.demo_button_label | replace: '[demo_price]', demo_price }}</button>
        {%- endif -%}
        {%- if s.cta_note != blank -%}<p class="lb-help lb-help--center">{{ s.cta_note }}</p>{%- endif -%}

        {%- if request.design_mode -%}
          {%- liquid
            assign warn = ''
            if s.webhook_url == blank and product == blank
              assign warn = warn | append: '<li>' | append: s.mode | append: ' page: add the Google Sheet webhook URL or choose a product, otherwise the button cannot send anything.</li>'
            elsif s.webhook_url == blank
              assign warn = warn | append: '<li>No Google Sheet webhook URL yet: orders still reach the cart, but the details are not saved to the sheet.</li>'
            endif
          -%}
          {%- if warn != blank -%}<ul class="lb-editor-warn">{{ warn }}</ul>{%- endif -%}
        {%- endif -%}
      </div>

      <div class="lb-order__trust">
        <div class="lb-trust">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'trust' -%}
                <div class="lb-trust__item" {{ block.shopify_attributes }}>
                  {%- render 'logam-bulk-icon', name: block.settings.icon -%}
                  <div><div class="lb-trust__title">{{ block.settings.title }}</div>{%- if block.settings.text != blank -%}<div class="lb-trust__text">{{ block.settings.text }}</div>{%- endif -%}</div>
                </div>
              {%- when 'payments' -%}
                <div class="lb-trust__item lb-trust__item--pay" {{ block.shopify_attributes }}>
                  <div class="lb-trust__row">{%- render 'logam-bulk-icon', name: 'lock' -%}<div class="lb-trust__title">{{ block.settings.title }}</div></div>
                  <ul class="lb-pay" aria-label="{{ block.settings.list_label | escape }}">
                    <li><img src="{{ 'lb-pay-upi.svg' | asset_url }}" alt="UPI" width="48" height="17" loading="lazy"></li>
                    <li><img src="{{ 'lb-pay-gpay.svg' | asset_url }}" alt="Google Pay" width="46" height="19" loading="lazy"></li>
                    <li><img src="{{ 'lb-pay-phonepe.svg' | asset_url }}" alt="PhonePe" width="58" height="17" loading="lazy"></li>
                    <li><img src="{{ 'lb-pay-paytm.svg' | asset_url }}" alt="Paytm" width="50" height="16" loading="lazy"></li>
                    <li><img src="{{ 'lb-pay-visa.svg' | asset_url }}" alt="Visa" width="46" height="15" loading="lazy"></li>
                    <li><img src="{{ 'lb-pay-mastercard.svg' | asset_url }}" alt="Mastercard" width="36" height="22" loading="lazy"></li>
                    <li><img src="{{ 'lb-pay-rupay.svg' | asset_url }}" alt="RuPay" width="50" height="15" loading="lazy"></li>
                    <li class="lb-pay__nb"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 9.3L12 4.5l8.5 4.8z"/><path d="M6 11v6M10 11v6M14 11v6M18 11v6"/><path d="M3.5 19.5h17"/></svg><span>{{ block.settings.netbanking }}</span></li>
                  </ul>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </form>
  </div>

  {%- if s.show_sticky -%}
    <div class="lb-sticky" data-lb-sticky>
      {%- if s.sticky_image != blank -%}
        {{ s.sticky_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', width: 46, height: 46 }}
      {%- else -%}
        <img src="{{ 'lb-bk-s2.jpg' | asset_url }}" alt="" width="46" height="46" loading="lazy">
      {%- endif -%}
      <div class="lb-sticky__txt">
        <div class="lb-sticky__title{% if s.sticky_green %} is-green{% endif %}">{{ s.sticky_title | replace: '[total]', b_total | replace: '[demo_price]', demo_price }}{% if s.sticky_was != blank %} <s>{{ s.sticky_was }}</s>{% endif %}</div>
        <div class="lb-sticky__line">{{ s.sticky_line | replace: '[qty]', b_qty | replace: '[unit]', b_unit | replace: '[demo_price]', demo_price }}</div>
      </div>
      <button type="button" class="lb-sticky__btn" data-lb-submit="{{ s.mode }}">{{ s.sticky_button }}</button>
    </div>
  {%- endif -%}

  <div class="lb-toast" data-lb-toast role="status" aria-live="polite"></div>

  {%- if s.product != blank or s.demo_product != blank -%}
    <div class="hh-overlay lb-cart" data-lb-drawer hidden>
      <button type="button" class="hh-scrim" data-lb-close aria-label="{{ dx.dr_close | escape }}"></button>
      <aside class="hh-drawer lb-cart__drawer" role="dialog" aria-modal="true" aria-label="{{ dx.dr_title | escape }}">
        {%- render 'logam-bulk-drawer' -%}
      </aside>
    </div>
  {%- endif -%}

  <script type="application/json" data-lb-config>
    {
      "mode": {{ s.mode | json }},
      "tiers": [{% for t in tiers %}{"min": {{ t.settings.min_qty | default: 1 }}, "price": {{ t.settings.price | default: 0 }}}{% unless forloop.last %},{% endunless %}{% endfor %}],
      "advance": {{ pct }},
      "langs": [{% for l in langs %}{"code": {{ l.settings.code | json }}, "value": {{ l.settings.value | json }}, "label": {{ l.settings.label | json }}, "chalisa": {{ l.settings.chalisa | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}],
      "bulkProduct": {{ s.product.id | default: 0 }},
      "bulkVariants": [{% if s.product != blank %}{% for v in s.product.variants %}{"id": {{ v.id }}, "title": {{ v.title | json }}, "price": {{ v.price }}}{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}],
      "demoProduct": {{ s.demo_product.id | default: 0 }},
      "demoVariant": {% if s.demo_product != blank %}{{ s.demo_product.selected_or_first_available_variant.id }}{% else %}0{% endif %},
      "demoPrice": {{ demo_price | strip | json }},
      "webhook": {{ s.webhook_url | strip | json }},
      "whatsapp": {{ s.whatsapp | remove: '+' | remove: ' ' | json }},
      "maxMb": {{ fx.max_mb | default: 25 }},
      "pv": {"brand": {{ sx.pv_brand | json }}, "slogan": {{ sx.pv_slogan | json }}, "phone": {{ sx.pv_phone | json }}, "address": {{ sx.pv_address | json }}},
      "t": {
        "nudge": {{ sx.nudge_text | json }},
        "jump": {{ sx.nudge_jump | json }},
        "max": {{ sx.nudge_max | json }},
        "fileType": {{ fx.file_type_toast | json }},
        "fileSize": {{ fx.file_size_toast | json }},
        "fileAdded": {{ fx.file_added | json }},
        "change": {{ fx.upload_change | json }},
        "missingOne": {{ mx.missing_one | json }},
        "missingMany": {{ mx.missing_many | json }},
        "sending": {{ mx.sending_label | json }},
        "uploading": {{ mx.uploading_label | json }},
        "sendError": {{ mx.send_error | json }},
        "notSetUp": {{ mx.not_set_up | json }},
