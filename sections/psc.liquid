{% comment %}
  Section: Promo CTA Bar
  - Full-width colored bar with heading, subheading, and right-aligned CTA.
  - CTA can add a chosen product's first available variant to cart (via AJAX) or act as a simple link.
  - Highly configurable via the Theme Editor.
{% endcomment %}

<section
  class="promo-cta-bar"
  style="--pcb-bg: {{ section.settings.bg_color }}; --pcb-text: {{ section.settings.text_color }}; --pcb-btn-bg: {{ section.settings.btn_bg }}; --pcb-btn-text: {{ section.settings.btn_text }}; --pcb-btn-bg-hover: {{ section.settings.btn_bg_hover }}; --pcb-btn-text-hover: {{ section.settings.btn_text_hover }}; --pcb-pad-y: {{ section.settings.pad_y }}px;"
>
  <div class="promo-cta-bar__container{% unless section.settings.full_bleed %} promo-cta-bar__container--constrained{% endunless %}" style="{% unless section.settings.full_bleed %}--pcb-max: {{ section.settings.max_width }}px{% endunless %}">
    <div class="promo-cta-bar__left">
      {% if section.settings.heading != blank %}
        <h3 class="promo-cta-bar__heading">{{ section.settings.heading | escape }}</h3>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="promo-cta-bar__subheading">{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </div>

   <div class="promo-cta-bar__right">
  {% if section.settings.cta_mode == 'product' and section.settings.product != blank %}
    {% assign chosen_product = all_products[section.settings.product] %}
    {% assign chosen_variant = chosen_product.first_available_variant | default: chosen_product.variants.first %}

    {% if section.settings.redirect_to_cart %}
      {%- comment -%}
        HARD REDIRECT PATH — no JS, guaranteed to land on Cart
      {%- endcomment -%}
      <form action="/cart/add?return_to=/cart" method="post">
        <input type="hidden" name="id" value="{{ chosen_variant.id }}">
        <input type="hidden" name="quantity" value="{{ section.settings.quantity | default: 1 }}">
        <button type="submit" class="promo-cta-bar__btn">
          <span class="promo-cta-bar__btn-label">
            {{ section.settings.button_label | default: 'Add to Cart' | escape }}
          </span>
        </button>
      </form>
    {% else %}
      {%- comment -%}
        AJAX ADD (stays on page, shows toast)
      {%- endcomment -%}
      <button
        class="promo-cta-bar__btn"
        data-mode="product"
        data-variant-id="{{ chosen_variant.id }}"
        aria-live="polite"
      >
        <span class="promo-cta-bar__btn-label">{{ section.settings.button_label | default: 'Add to Cart' | escape }}</span>
        <span class="promo-cta-bar__btn-spinner" hidden aria-hidden="true"></span>
      </button>
    {% endif %}

  {% else %}
    {% assign cta_url = section.settings.button_link | default: '#' %}
    <a
      class="promo-cta-bar__btn"
      href="{{ cta_url }}"
      {% if section.settings.open_new_tab %}target="_blank" rel="noopener nofollow"{% endif %}
    >
      <span class="promo-cta-bar__btn-label">{{ section.settings.button_label | escape }}</span>
    </a>
  {% endif %}
</div>

  </div>

  {% if section.settings.show_divider %}
  <div class="promo-cta-bar__divider" role="presentation"></div>
  {% endif %}
</section>

<style>
  .promo-cta-bar {
    background: var(--pcb-bg);
    color: var(--pcb-text);
    padding: var(--pcb-pad-y) 0;
  }
  .promo-cta-bar__container {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 16px;
    width: 100%;
  }
  .promo-cta-bar__container--constrained {
    max-width: var(--pcb-max, 1200px);
    margin: 0 auto;
    padding: 0 16px;
  }
  .promo-cta-bar__left {
    min-width: 0;
  }
  .promo-cta-bar__heading {
    margin: 0 0 4px 0;
    font-size: clamp(14px, 1.2vw + 10px, 18px);
    line-height: 1.25;
    color: var(--pcb-text);
  }
  .promo-cta-bar__subheading {
    margin: 0;
    opacity: .9;
    font-size: clamp(11px, 1vw + 8px, 14px);
    line-height: 1.4;
    color: var(--pcb-text);
  }
  .promo-cta-bar__right {
    display: flex;
    justify-content: flex-end;
  }
  .promo-cta-bar__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 18px;
    border-radius: 999px;
    text-decoration: none;
    border: 0;
    cursor: pointer;
    background: var(--pcb-btn-bg);
    color: var(--pcb-btn-text);
    font-size: 14px;
    line-height: 1;
    transition: transform .15s ease, background .15s ease, color .15s ease, box-shadow .15s ease;
    white-space: nowrap;
    box-shadow: 0 0 0 1px rgba(0,0,0,.04), 0 2px 6px rgba(0,0,0,.12);
  }
  .promo-cta-bar__btn:hover,
  .promo-cta-bar__btn:focus-visible {
    background: var(--pcb-btn-bg-hover);
    color: var(--pcb-btn-text-hover);
    transform: translateY(-1px);
  }
  .promo-cta-bar__btn:active {
    transform: translateY(0);
  }
  .promo-cta-bar__btn-spinner {
    width: 16px;
    height: 16px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    margin-left: 8px;
    animation: pcb-spin .8s linear infinite;
  }
  @keyframes pcb-spin { to { transform: rotate(360deg); } }

  .promo-cta-bar__divider {
    height: 1px;
    background: rgba(0,0,0,.08);
  }

  @media (max-width: 640px) {
    .promo-cta-bar__container {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .promo-cta-bar__right { justify-content: flex-start; }
  }
</style>

{% if section.settings.cta_mode == 'product' and section.settings.product != blank %}
<script>
  (function() {
    var root = document.currentScript.closest('.promo-cta-bar');
    var btn = root && root.querySelector('.promo-cta-bar__btn[data-mode="product"]');
    if (!btn) return;

    var redirectToCart = {{ section.settings.redirect_to_cart | json }};
    var quantity = Math.max(1, {{ section.settings.quantity | default: 1 | json }});
    var successMessage = {{ section.settings.success_text | json }};

    function setLoading(isLoading) {
      var spinner = btn.querySelector('.promo-cta-bar__btn-spinner');
      var label = btn.querySelector('.promo-cta-bar__btn-label');
      if (spinner) spinner.hidden = !isLoading;
      if (label) label.style.opacity = isLoading ? '0.7' : '1';
      btn.disabled = isLoading;
      btn.setAttribute('aria-busy', isLoading ? 'true' : 'false');
    }

    btn.addEventListener('click', function(e) {
      e.preventDefault();
      var id = btn.getAttribute('data-variant-id');
      if (!id) return;

      setLoading(true);

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ id: Number(id), quantity: quantity })
      })
      .then(function(r){ return r.json(); })
      .then(function() {
        setLoading(false);
        if (redirectToCart) {
          window.location.href = '/cart';
        } else {
          // Lightweight toast
          var toast = document.createElement('div');
          toast.textContent = successMessage || 'Added to cart';
          toast.style.cssText = 'position:fixed;right:16px;bottom:16px;background:#111;color:#fff;padding:10px 14px;border-radius:12px;z-index:9999;font-size:14px;opacity:.98';
          document.body.appendChild(toast);
          setTimeout(function(){ toast.remove(); }, 2200);
          // Optional: trigger theme mini-cart open (if your theme listens to this event)
          document.dispatchEvent(new CustomEvent('cart:refresh'));
        }
      })
      .catch(function() {
        setLoading(false);
        alert('Sorry, something went wrong while adding to cart.');
      });
    });
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "Promo CTA Bar",
  "tag": "section",
  "class": "section-promo-cta-bar",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A Small Book. A Lifelong Blessing."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Teach devotion, not through words – but by habit."
    },

    {
      "type": "radio",
      "id": "cta_mode",
      "label": "CTA mode",
      "default": "product",
      "options": [
        { "value": "product", "label": "Add product to cart" },
        { "value": "link", "label": "Link to a page" }
      ]
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product to add (when in product mode)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add Pocket Chalisa to Cart"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link (when in link mode)"
    },
    {
      "type": "checkbox",
      "id": "open_new_tab",
      "label": "Open link in new tab (link mode)",
      "default": false
    },
    {
      "type": "range",
      "id": "quantity",
      "label": "Quantity to add",
      "default": 1,
      "min": 1,
      "max": 10,
      "step": 1
    },
    {
      "type": "checkbox",
      "id": "redirect_to_cart",
      "label": "Redirect to cart after add",
      "default": false
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message (when staying on page)",
      "default": "Added to cart!"
    },

    {
      "type": "color",
      "id": "bg_color",
      "label": "Bar background",
      "default": "#cc6200"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Button text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_bg_hover",
      "label": "Button background (hover)",
      "default": "#f0f0f0"
    },
    {
      "type": "color",
      "id": "btn_text_hover",
      "label": "Button text (hover)",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "pad_y",
      "label": "Vertical padding",
      "min": 8,
      "max": 32,
      "step": 1,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "full_bleed",
      "label": "Use full page width",
      "default": true
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width (when not full width)",
      "min": 800,
      "max": 1600,
      "step": 20,
      "default": 1200
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show 1px divider under bar",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Promo CTA Bar",
      "category": "Banners"
    }
  ]
}
{% endschema %}
