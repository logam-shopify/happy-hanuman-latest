{%- render 'logam-book-stats', hi: true -%}

{% schema %}
{
  "name": "Logam-Gujarati Stats",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Record photo" },
    { "type": "text", "id": "eyebrow", "label": "Small text", "default": "ગિનેસ વર્લ્ડ રેકોર્ડ હોલ્ડર" },
    { "type": "text", "id": "title", "label": "Heading", "default": "30 કલાકમાં 30,303 પુસ્તકો પર હસ્તાક્ષર" },
    { "type": "text", "id": "sub", "label": "Text", "default": "સુરત, ગુજરાત · 3 ડિસેમ્બર 2024 · 1,00,000+ વાચકો" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#2B1A0E" },
    { "type": "range", "id": "pt_m", "label": "Top padding (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "pb_m", "label": "Bottom padding (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "pt", "label": "Top padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "pb", "label": "Bottom padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [ { "name": "Logam-Gujarati Stats" } ]
}
{% endschema %}
