          "default": "Pocket Hanuman Chalisa with your brand"
        },
        {
          "type": "select",
          "id": "position",
          "label": "Caption position",
          "options": [
            {
              "value": "top",
              "label": "Top"
            },
            {
              "value": "bottom",
              "label": "Bottom"
            }
