          "label": "Small text",
          "default": "STEP 1 · TODAY"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "1 free book with your brand"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Pay ₹69 delivery"
        },
        {
