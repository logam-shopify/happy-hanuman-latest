{%- liquid
  assign s = section.settings
-%}

<div class="lg-reels" style="--lg-reels-bg: {{ s.bg_color }}; --lg-reels-text: {{ s.text_color }}; --lg-reels-pt: {{ s.padding_top }}px; --lg-reels-pb: {{ s.padding_bottom }}px;">
  <div class="lg-reels__inner">
    <div class="lg-reels__head">
      {%- if s.heading != blank -%}
        <h2 class="lg-reels__heading">{{ s.heading | escape }}</h2>
      {%- endif -%}
      {%- if s.description != blank -%}
        <p class="lg-reels__sub">{{ s.description | escape }}</p>
      {%- endif -%}
    </div>

    <div class="lg-reels__track" data-lg-reels>
      {%- for block in section.blocks -%}
        {%- if block.settings.video_url != blank -%}
          <div class="lg-reels__item" {{ block.shopify_attributes }}>
            <video
              class="lg-reels__video"
              src="{{ block.settings.video_url }}#t=0.1"
              muted
              loop
              playsinline
              preload="metadata"
              aria-label="Customer video {{ forloop.index }}"
            ></video>
            <button type="button" class="lg-reels__sound" aria-label="Turn sound on" aria-pressed="false">
              <svg class="lg-reels__ico-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z"/><path d="M17 9l4 6M21 9l-4 6"/></svg>
              <svg class="lg-reels__ico-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z"/><path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"/></svg>
            </button>
            {%- if block.settings.product_link != blank -%}
              <a class="lg-reels__shop" href="{{ block.settings.product_link }}">{{ s.shop_label | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .lg-reels {
    background: var(--lg-reels-bg);
    color: var(--lg-reels-text);
    padding: var(--lg-reels-pt) 0 var(--lg-reels-pb);
  }
  #shopify-section-{{ section.id }} .lg-reels__inner { max-width: 1340px; margin: 0 auto; }
  #shopify-section-{{ section.id }} .lg-reels__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    padding: 0 40px;
    margin-bottom: 44px;
  }
  #shopify-section-{{ section.id }} .lg-reels__heading {
    margin: 0;
    max-width: 520px;
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 700;
    line-height: 1.3;
    color: var(--lg-reels-text);
  }
  #shopify-section-{{ section.id }} .lg-reels__sub { margin: 0 0 8px; max-width: 470px; font-size: 16px; line-height: 1.45; }

  #shopify-section-{{ section.id }} .lg-reels__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 80px - 72px) / 4);
    gap: 24px;
    padding: 12px 40px 32px;
    margin: -12px 0 -32px;
    scroll-padding: 0 40px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  #shopify-section-{{ section.id }} .lg-reels__track::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .lg-reels__item {
    position: relative;
    aspect-ratio: 305 / 444;
    border-radius: 14px;
    overflow: hidden;
    background: #c4c4c4;
    scroll-snap-align: start;
    box-shadow: 0 6px 16px rgba(0, 0, 0, .12);
  }
  #shopify-section-{{ section.id }} .lg-reels__video { width: 100%; height: 100%; object-fit: cover; display: block; cursor: pointer; }
  #shopify-section-{{ section.id }} .lg-reels__sound {
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 34px;
    height: 34px;
    padding: 0;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, .45);
    color: #fff;
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .lg-reels__sound svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  #shopify-section-{{ section.id }} .lg-reels__ico-on { display: none; }
  #shopify-section-{{ section.id }} .lg-reels__sound[aria-pressed="true"] .lg-reels__ico-on { display: block; }
  #shopify-section-{{ section.id }} .lg-reels__sound[aria-pressed="true"] .lg-reels__ico-off { display: none; }
  #shopify-section-{{ section.id }} .lg-reels__shop {
    position: absolute;
    left: 10px;
    bottom: 10px;
    padding: 7px 14px;
    border-radius: 999px;
    background: #fff;
    color: #1a1a1a;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .lg-reels__head { display: block; padding: 0 18px; margin-bottom: 20px; }
    #shopify-section-{{ section.id }} .lg-reels__heading { font-size: 22px; line-height: 1.5; max-width: 330px; }
    #shopify-section-{{ section.id }} .lg-reels__sub { margin: 8px 0 0; font-size: 13px; line-height: 1.35; }
    #shopify-section-{{ section.id }} .lg-reels__track {
      grid-auto-columns: 38%;
      gap: 12px;
      padding: 0 18px 8px;
      margin: 0;
      scroll-padding: 0 18px;
    }
    #shopify-section-{{ section.id }} .lg-reels__item { aspect-ratio: 152 / 257; border-radius: 16px; box-shadow: none; }
    #shopify-section-{{ section.id }} .lg-reels__sound { width: 30px; height: 30px; right: 8px; bottom: 8px; }
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .lg-reels { padding-top: {{ section.settings.padding_top_mobile }}px; padding-bottom: {{ section.settings.padding_bottom_mobile }}px; }
  }
</style>

<script>
  (function () {
    var track = document.querySelector('#shopify-section-{{ section.id }} [data-lg-reels]');
    if (!track || track.dataset.ready) return;
    track.dataset.ready = '1';
    var videos = track.querySelectorAll('video');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if ('IntersectionObserver' in window && !reduce) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { var p = e.target.play(); if (p) p.catch(function () {}); }
          else e.target.pause();
        });
      }, { threshold: 0.6 });
      videos.forEach(function (v) { io.observe(v); });
    }

    function toggleSound(item) {
      var v = item.querySelector('video');
      var btn = item.querySelector('.lg-reels__sound');
      var on = v.muted;
      videos.forEach(function (o) {
        if (o !== v) {
          o.muted = true;
          var b = o.parentNode.querySelector('.lg-reels__sound');
          b.setAttribute('aria-pressed', 'false');
          b.setAttribute('aria-label', 'Turn sound on');
        }
      });
      v.muted = !on;
      if (on) { var p = v.play(); if (p) p.catch(function () {}); }
      btn.setAttribute('aria-pressed', String(on));
      btn.setAttribute('aria-label', on ? 'Turn sound off' : 'Turn sound on');
    }

    track.addEventListener('click', function (e) {
      var item = e.target.closest('.lg-reels__item');
      if (!item || e.target.closest('.lg-reels__shop')) return;
      toggleSound(item);
    });
  })();
</script>

{% schema %}
{
  "name": "Logam Reels",
  "tag": "section",
  "class": "section--logam-reels",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Happy Hanuman in Real Hands, Real Homes" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Over 1,00,000 children, educators, and parents discovering strength, calm, and genuine joy in sacred connection." },
    { "type": "text", "id": "shop_label", "label": "Product link label", "default": "Shop" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#14201A" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top — desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom — desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top — mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom — mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "url", "id": "video_url", "label": "Video URL (.mp4)" },
        { "type": "url", "id": "product_link", "label": "Product link", "info": "Shows a Shop button on the video." }
      ]
    }
  ],
  "presets": [
    { "name": "Logam Reels", "blocks": [ { "type": "video" } ] }
  ]
}
{% endschema %}
