{%- render 'logam-book-details' -%}

{% schema %}
{
  "name": "Logam-English Details",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small text",
      "default": "Details"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "About this edition"
    },
    {
      "type": "text",
      "id": "sub",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#FFF8EE"
    },
    {
      "type": "range",
      "id": "pt_m",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "pb_m",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Edition"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "info": "Use the dynamic source icon to connect a product metafield.",
          "default": "English"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logam-English Details",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "label": "Edition",
            "value": "English"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Format",
            "value": "A4"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Pages",
            "value": "43, hand-illustrated"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Best for",
            "value": "Children and adults: families, parents, teachers, seekers"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Delivery",
            "value": "Free, in 3–5 business days"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Replacement",
            "value": "Within 7 days if damaged in transit or the wrong edition arrives"
          }
        }
      ]
    }
  ]
}
{% endschema %}
