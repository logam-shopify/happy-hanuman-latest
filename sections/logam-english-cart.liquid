{%- render 'logam-book-cart' -%}

{% schema %}
{
  "name": "Logam-English Cart",
  "tag": "div",
  "class": "logam-cart-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Cart drawer for the Logam book pages. Opens on Add to cart, the step 5 buttons and the header cart icon."
    },
    {
      "type": "header",
      "content": "Step 5 product"
    },
    {
      "type": "checkbox",
      "id": "show_journey",
      "label": "Show Hanuman ji's journey and the step 5 card",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "offer_on",
      "label": "Step 5 offer is active",
      "default": false,
      "info": "Off: the journey and step 5 card are design only, and 'Add step 5' does nothing. Turn on once the step 5 product and the 10% discount are set up."
    },
    {
      "type": "number",
      "id": "unlock_amount",
      "label": "Unlock step 5 at cart value (₹)",
      "default": 1998,
      "info": "Same as the minimum purchase of your 10% discount."
    },
    {
      "type": "product",
      "id": "step5_product",
      "label": "Step 5 product (Colouring Sheets)",
      "info": "Its price and image load automatically. The offer needs this product and 'Step 5 offer is active'."
    },
    {
      "type": "image_picker",
      "id": "step5_image",
      "label": "Step 5 card photo",
      "info": "Optional. Shows the colouring sheets photo from the design if empty."
    },
    {
      "type": "text",
      "id": "step5_title",
      "label": "Step 5 product name",
      "info": "Leave empty to use the product title.",
      "default": "Art Therapy Colouring Sheets"
    },
    {
      "type": "text",
      "id": "step5_line",
      "label": "Step 5 line text in cart",
      "default": "43 sheets · step 5"
    },
    {
      "type": "text",
      "id": "card_price",
      "label": "Step 5 card price (no product selected)",
      "default": "₹999"
    },
    {
      "type": "text",
      "id": "card_compare",
      "label": "Step 5 card old price (no product selected)",
      "default": "₹1,999"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Cart"
    },
    {
      "type": "text",
      "id": "item_one",
      "label": "Item (1)",
      "default": "item"
    },
    {
      "type": "text",
      "id": "item_many",
      "label": "Items (2+)",
      "default": "items"
    },
    {
      "type": "text",
      "id": "close_label",
      "label": "Close (screen readers)",
      "default": "Close cart"
    },
    {
      "type": "header",
      "content": "Hanuman ji's journey"
    },
    {
      "type": "text",
      "id": "j_title",
      "label": "Heading (before step 5)",
      "default": "Kids, help Hanuman ji reach step 5!"
    },
    {
      "type": "text",
      "id": "j_title_done",
      "label": "Heading (step 5 reached)",
      "default": "Jai Shri Ram! Hanuman ji reached step 5"
    },
    {
      "type": "text",
      "id": "pill",
      "label": "Step badge (before)",
      "default": "4 of 5 steps"
    },
    {
      "type": "text",
      "id": "pill_done",
      "label": "Step badge (after)",
      "default": "5 of 5 steps"
    },
    {
      "type": "text",
      "id": "label_book",
      "label": "Label under steps 1–4",
      "default": "Steps 1–4: the book"
    },
    {
      "type": "text",
      "id": "label_step5",
      "label": "Step 5 label (before)",
      "default": "Step 5 · 10% off"
    },
    {
      "type": "text",
      "id": "label_step5_done",
      "label": "Step 5 label (after)",
      "default": "10% off unlocked"
    },
    {
      "type": "inline_richtext",
      "id": "j_text",
      "label": "Text (before)",
      "default": "Add the Colouring Sheets: he reaches step 5 and you get <b>10% off the total</b>."
    },
    {
      "type": "inline_richtext",
      "id": "j_text_done",
      "label": "Text (after)",
      "default": "All 5 steps unlocked, and <b>10% off</b> your whole cart."
    },
    {
      "type": "text",
      "id": "hanuman_label",
      "label": "Picture description (screen readers)",
      "default": "Hanuman ji flying with the Sanjeevani mountain"
    },
    {
      "type": "header",
      "content": "Cart lines"
    },
    {
      "type": "text",
      "id": "remove",
      "label": "Remove",
      "default": "Remove"
    },
    {
      "type": "text",
      "id": "qty_less",
      "label": "Decrease (screen readers)",
      "default": "Decrease quantity"
    },
    {
      "type": "text",
      "id": "qty_more",
      "label": "Increase (screen readers)",
      "default": "Increase quantity"
    },
    {
      "type": "header",
      "content": "Step 5 card"
    },
    {
      "type": "text",
      "id": "up_eyebrow",
      "label": "Small text",
      "default": "Step 5 · Made for kids"
    },
    {
      "type": "text",
      "id": "up_text",
      "label": "Text",
      "default": "43 sheets to colour, one for every chaupai. More Ram Naam to find!"
    },
    {
      "type": "text",
      "id": "up_off",
      "label": "Offer line",
      "default": "+ 10% off your whole cart"
    },
    {
      "type": "text",
      "id": "up_button",
      "label": "Button",
      "default": "Add step 5"
    },
    {
      "type": "header",
      "content": "Footer"
    },
    {
      "type": "text",
      "id": "disc_label",
      "label": "Discount line",
      "info": "Shown when Shopify applies a discount. Create the 10% automatic discount in Shopify admin → Discounts.",
      "default": "10% off your cart"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label",
      "default": "Est. total"
    },
    {
      "type": "text",
      "id": "checkout",
      "label": "Checkout button",
      "default": "Check out ›"
    },
    {
      "type": "text",
      "id": "foot_note",
      "label": "Note under checkout",
      "default": "Free shipping · Pay just 20% now"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty cart text",
      "default": "Your cart is empty"
    },
    {
      "type": "text",
      "id": "empty_button",
      "label": "Empty cart button",
      "default": "Continue shopping"
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "line",
      "name": "Book line text",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Or use the match word below."
        },
        {
          "type": "text",
          "id": "match",
          "label": "Match word",
          "info": "Used when the product title or handle contains this word, e.g. english."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Name in cart",
          "info": "Optional. Uses the product title if empty."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Line text",
          "default": "A4 · steps 1–4"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "line",
        "settings": {
          "match": "english",
          "title": "Happy Hanuman Therapy Book",
          "text": "English edition · A4 · steps 1–4"
        }
      },
      {
        "type": "line",
        "settings": {
          "match": "hindi",
          "title": "Happy Hanuman Therapy Book",
          "text": "हिन्दी edition · A4 · steps 1–4"
        }
      },
      {
        "type": "line",
        "settings": {
          "match": "gujarati",
          "title": "Happy Hanuman Therapy Book",
          "text": "ગુજરાતી edition · A4 · steps 1–4"
        }
      }
    ]
  }
}
{% endschema %}
