{%- render 'logam-book-videos' -%}

{% schema %}
{
  "name": "Logam-English Videos",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small text",
      "default": "Watch"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Hear it from readers"
    },
    {
      "type": "text",
      "id": "sub",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "dcols",
      "label": "Videos per row (desktop)",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#FFF8EE"
    },
    {
      "type": "range",
      "id": "pt_m",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "pb_m",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Upload a vertical (9:16) video."
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Cover image",
          "info": "Optional. The video's own preview is used if empty."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "text",
          "id": "duration",
          "label": "Duration label",
          "default": "0:52"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logam-English Videos",
      "blocks": [
        {
          "type": "video",
          "settings": {
            "duration": "2:45"
          }
        },
        {
          "type": "video",
          "settings": {
            "duration": "0:52"
          }
        },
        {
          "type": "video",
          "settings": {
            "duration": "0:49"
          }
        },
        {
          "type": "video",
          "settings": {
            "duration": "1:04"
          }
        }
      ]
    }
  ]
}
{% endschema %}
