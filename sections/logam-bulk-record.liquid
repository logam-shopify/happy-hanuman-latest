{%- render 'logam-hindi-assets' -%}
{{ 'logam-bulk-extras.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #lh-{{ section.id }} { --lh-bg: {{ section.settings.bg }}; --lh-pt-m: {{ section.settings.pt_m }}px; --lh-pb-m: {{ section.settings.pb_m }}px; --lh-pt: {{ section.settings.pt }}px; --lh-pb: {{ section.settings.pb }}px; }
{%- endstyle -%}
<section id="lh-{{ section.id }}" class="lh lh--dark lb-record">
  <div class="lh__in lb-record__rows">
    {%- for block in section.blocks -%}
      <div class="lb-record__row" {{ block.shopify_attributes }}>
        {%- if block.settings.media == 'image' -%}
          <div class="lb-record__media lb-record__media--img">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 300 | image_tag: widths: '100, 200, 300', sizes: '(min-width: 1200px) 100px, 80px', loading: 'lazy', alt: block.settings.image.alt | escape }}
            {%- else -%}
              <img class="lb-record__seal" src="{{ 'lb-bk-template.jpg' | asset_url }}" alt="" width="1200" height="896" loading="lazy" decoding="async">
            {%- endif -%}
          </div>
        {%- elsif block.settings.media == 'award' -%}
          <div class="lb-record__media lb-record__media--icon"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="9" r="5.5"/><path d="M8.6 13.3L7 21l5-2.6 5 2.6-1.6-7.7"/><path class="lb-fill" d="M12 6.3l.9 1.8 2 .3-1.4 1.4.3 2-1.8-1-1.8 1 .3-2-1.4-1.4 2-.3z"/></svg></div>
        {%- endif -%}
        <div>
          {%- if block.settings.eyebrow != blank -%}<p class="lh-eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
          {%- if block.settings.title != blank -%}<h2 class="lh-title lb-record__title">{{ block.settings.title }}</h2>{%- endif -%}
          {%- if block.settings.text != blank -%}<p class="lb-record__text">{{ block.settings.text }}</p>{%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Logam-Bulk Record",
  "tag": "div",
  "max_blocks": 3,
  "settings": [
    {
      "type": "paragraph",
      "content": "Dark band. Rows stack on mobile and sit side by side on desktop."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#2B1A0E"
    },
    {
      "type": "range",
      "id": "pt_m",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "pb_m",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "select",
          "id": "media",
          "label": "Media",
          "options": [
            { "value": "award", "label": "Award icon" },
            { "value": "image", "label": "Round image" },
            { "value": "none", "label": "None" }
          ],
          "default": "award"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Round image",
          "info": "Used when Media is Round image. Empty: shows the Mission 100 Million seal from the back cover."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Small text",
          "default": "Guinness World Record holder"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "30,303 books signed in 30 hours"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Surat, Gujarat · 3 December 2024 · 1,00,000+ readers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logam-Bulk Record",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "media": "award",
            "eyebrow": "Guinness World Record holder",
            "title": "30,303 books signed in 30 hours",
            "text": "Surat, Gujarat · 3 December 2024 · 1,00,000+ readers"
          }
        },
        {
          "type": "row",
          "settings": {
            "media": "image",
            "eyebrow": "Mission 100 Million",
            "title": "One mission, one India, every child",
            "text": "Every book carries the Mission 100 Million seal: Happy Hanuman Chalisa for kids. Your order is part of it."
          }
        }
      ]
    }
  ]
}
{% endschema %}
