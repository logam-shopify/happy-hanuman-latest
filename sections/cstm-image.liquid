{% schema %}
{
  "name": "Responsive Image Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },
    {
      "type": "url",
      "id": "banner_link",
      "label": "Banner Link"
    }
  ],
  "presets": [
    {
      "name": "Responsive Banner"
    }
  ]
}
{% endschema %}

<div class="responsive-banner">
  {% if section.settings.desktop_image %}
    <a href="{{ section.settings.banner_link }}" class="banner-link">
      <img 
        src="{{ section.settings.desktop_image | image_url: width: 2000 }}" 
        alt="Desktop Banner" 
        class="banner-img desktop-img"
      >
    </a>
  {% endif %}

  {% if section.settings.mobile_image %}
    <a href="{{ section.settings.banner_link }}" class="banner-link">
      <img 
        src="{{ section.settings.mobile_image | image_url: width: 1000 }}" 
        alt="Mobile Banner" 
        class="banner-img mobile-img"
      >
    </a>
  {% endif %}
</div>

<style>
.responsive-banner {
  max-width: 1200px;   /* Limit banner width */
  height: auto;        /* Set a fixed height, adjust as needed */
  margin: 0 auto;      /* Center it */
  position: relative;
  overflow: hidden;    /* Hide any overflow */
}

.banner-link {
  display: block;      /* Make the link take up the full size of the image */
  width: 100%;
  height: 100%;
}

.banner-img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
}

/* By default show desktop */
.desktop-img { display: block; }
.mobile-img { display: none; }

/* On mobile switch */
@media (max-width: 767px) {
  .desktop-img { display: none; }
  .mobile-img { display: block; }
}
</style>
