{%- comment -%} Bulk order / Free demo: "Inside the book". Photo + checklist. {%- endcomment -%}
{%- render 'logam-hindi-assets' -%}
{{ 'logam-bulk-content.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #lh-{{ section.id }} { --lh-bg: {{ section.settings.bg }}; --lh-pt-m: {{ section.settings.pt_m }}px; --lh-pb-m: {{ section.settings.pb_m }}px; --lh-pt: {{ section.settings.pt }}px; --lh-pb: {{ section.settings.pb }}px; }
{%- endstyle -%}
<section id="lh-{{ section.id }}" class="lh lb-inside">
  <div class="lh__in">
    {%- render 'logam-hindi-heading', eyebrow: section.settings.eyebrow, title: section.settings.title, sub: section.settings.sub -%}
    <div class="lb-inside__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 1200px) 532px, (min-width: 750px) 50vw, calc(100vw - 32px)', loading: 'lazy', alt: section.settings.image_alt }}
      {%- else -%}
        <img src="{{ 'lb-bk-inside.jpg' | asset_url }}" width="1024" height="1024" alt="{{ section.settings.image_alt | escape }}" loading="lazy">
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ul class="lb-inside__list" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
            <span>{{ block.settings.text }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Logam-Bulk Inside book",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small text",
      "default": "Inside the book"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Vedic, scientific & psychological Sanjeevani"
    },
    {
      "type": "text",
      "id": "sub",
      "label": "Subheading"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Empty: shows the open-book photo from the design. Square on mobile, 4:3 on desktop."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description (alt text)",
      "default": "The open pocket Hanuman Chalisa on a silk cloth: a chaupai, its meaning and a painting"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#FFF8EE"
    },
    {
      "type": "range",
      "id": "pt_m",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "pb_m",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Point",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "The complete Hanuman Chalisa, chaupai by chaupai"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logam-Bulk Inside book",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "The complete Hanuman Chalisa, chaupai by chaupai"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "The meaning of each chaupai in simple words"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "An “Ask yourself” question to reflect on"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "A colourful painting beside the words"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Gold-foil cover, pocket size"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "In English, हिन्दी or ગુજરાતી"
          }
        }
      ]
    }
  ]
}
{% endschema %}
