{%- liquid
  assign s = section.settings
-%}

<div class="lg-coll" style="--lg-coll-bg: {{ s.bg_color }}; --lg-coll-text: {{ s.text_color }}; --lg-coll-accent: {{ s.accent_color }}; --lg-coll-pt: {{ s.padding_top }}px; --lg-coll-pb: {{ s.padding_bottom }}px;">
  <div class="lg-coll__inner">
    {%- if s.heading != blank -%}
      <h2 class="lg-coll__heading">{{ s.heading | escape }}</h2>
    {%- endif -%}
    {%- if s.description != blank -%}
      <p class="lg-coll__sub">{{ s.description | escape }}</p>
    {%- endif -%}

    <div class="lg-coll__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign v = p.selected_or_first_available_variant
          assign save = 0
          if v.compare_at_price > v.price
            assign save = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price
          endif
        -%}
        <div class="lg-coll__card" {{ block.shopify_attributes }}>
          <a class="lg-coll__media" href="{{ p.url | default: '#' }}" tabindex="-1" aria-hidden="true">
            {%- if p.featured_image != blank -%}
              {{ p.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(max-width: 749px) 90vw, 260px', alt: p.title }}
            {%- endif -%}
            {%- if block.settings.badge != blank -%}
              <span class="lg-coll__badge{% if block.settings.badge_filled %} is-filled{% endif %}">{{ block.settings.badge | escape }}</span>
            {%- endif -%}
          </a>

          {%- if block.settings.reviews != blank -%}
            <div class="lg-coll__reviews">
              <span class="lg-coll__stars" aria-hidden="true">
                {%- for i in (1..5) -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M12 3.2l2.7 5.6 6.1.8-4.5 4.2 1.1 6.1L12 17l-5.4 2.9 1.1-6.1-4.5-4.2 6.1-.8z"/></svg>
                {%- endfor -%}
              </span>
              <span>{{ block.settings.reviews | escape }}</span>
            </div>
          {%- endif -%}

          <h3 class="lg-coll__title">
            <a href="{{ p.url | default: '#' }}">{{ block.settings.title | default: p.title | escape }}</a>
          </h3>
          {%- if block.settings.subtitle != blank -%}
            <p class="lg-coll__meta">{{ block.settings.subtitle | escape }}</p>
          {%- endif -%}

          {%- if v -%}
            <div class="lg-coll__price">
              <span class="lg-coll__now">{{ v.price | money }}</span>
              {%- if save > 0 -%}
                <s class="lg-coll__was">{{ v.compare_at_price | money }}</s>
                <span class="lg-coll__save">Save {{ save }}%</span>
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="lg-coll__actions">
            <a class="lg-coll__btn lg-coll__btn--ghost" href="{{ p.url | default: '#' }}">{{ s.details_label | escape }}</a>
            {%- if v.available -%}
              <form action="{{ routes.cart_add_url }}" method="post" class="lg-coll__form">
                <input type="hidden" name="id" value="{{ v.id }}">
                <input type="hidden" name="quantity" value="1">
                <input type="hidden" name="return_to" value="/checkout">
                <button type="submit" class="lg-coll__btn lg-coll__btn--solid">{{ s.buy_label | escape }}</button>
              </form>
            {%- else -%}
              <button type="button" class="lg-coll__btn lg-coll__btn--solid" disabled>{{ 'products.product.sold_out' | t }}</button>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .lg-coll {
    background: var(--lg-coll-bg);
    color: var(--lg-coll-text);
    padding: var(--lg-coll-pt) 20px var(--lg-coll-pb);
  }
  #shopify-section-{{ section.id }} .lg-coll__inner { max-width: 1120px; margin: 0 auto; }
  #shopify-section-{{ section.id }} .lg-coll__heading {
    max-width: 480px;
    margin: 0 auto 20px;
    text-align: center;
    font-size: clamp(26px, 3.4vw, 40px);
    font-weight: 700;
    line-height: 1.3;
    color: var(--lg-coll-accent);
  }
  #shopify-section-{{ section.id }} .lg-coll__sub { max-width: 580px; margin: 0 auto 40px; text-align: center; font-size: 16px; line-height: 1.5; }

  #shopify-section-{{ section.id }} .lg-coll__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 340px));
    justify-content: center;
    gap: 26px;
  }
  #shopify-section-{{ section.id }} .lg-coll__card {
    display: flex;
    flex-direction: column;
    padding: 12px 12px 18px;
    border: 1px solid #eee;
    border-radius: 24px;
    background: #fff;
  }
  #shopify-section-{{ section.id }} .lg-coll__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    overflow: hidden;
    background: #e9e7e3;
  }
  #shopify-section-{{ section.id }} .lg-coll__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .lg-coll__badge {
    position: absolute;
    top: 9px;
    left: 9px;
    padding: 3px 8px;
    border-radius: 999px;
    background: #fff;
    color: #1a1a1a;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .02em;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .lg-coll__badge.is-filled { background: var(--lg-coll-accent); color: #fff; }

  #shopify-section-{{ section.id }} .lg-coll__reviews { display: flex; align-items: center; gap: 6px; margin-top: 14px; font-size: 13px; }
  #shopify-section-{{ section.id }} .lg-coll__stars { display: inline-flex; gap: 1px; color: var(--lg-coll-accent); }
  #shopify-section-{{ section.id }} .lg-coll__stars svg { width: 13px; height: 13px; }
  #shopify-section-{{ section.id }} .lg-coll__title { margin: 8px 0 0; font-size: 20px; font-weight: 500; line-height: 1.25; }
  #shopify-section-{{ section.id }} .lg-coll__title a { color: inherit; text-decoration: none; }
  #shopify-section-{{ section.id }} .lg-coll__meta { margin: 8px 0 0; font-size: 14px; line-height: 1.45; opacity: .85; }
  #shopify-section-{{ section.id }} .lg-coll__price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 6px; margin-top: auto; padding-top: 14px; }
  #shopify-section-{{ section.id }} .lg-coll__now { font-size: 20px; font-weight: 600; color: var(--lg-coll-accent); }
  #shopify-section-{{ section.id }} .lg-coll__was { font-size: 13px; opacity: .6; }
  #shopify-section-{{ section.id }} .lg-coll__save { margin-left: 8px; padding: 2px 6px; border-radius: 3px; background: #c8f2d2; color: #1b5e2f; font-size: 12px; }

  #shopify-section-{{ section.id }} .lg-coll__actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 16px; }
  #shopify-section-{{ section.id }} .lg-coll__form { margin: 0; display: contents; }
  #shopify-section-{{ section.id }} .lg-coll__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 44px;
    padding: 0 10px;
    border: 0;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: .02em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .lg-coll__btn--ghost { background: #efeeea; color: #1a1a1a; }
  #shopify-section-{{ section.id }} .lg-coll__btn--solid { background: var(--lg-coll-accent); color: #fff; }
  #shopify-section-{{ section.id }} .lg-coll__btn--solid:disabled { opacity: .5; cursor: not-allowed; }
  #shopify-section-{{ section.id }} .lg-coll__btn:hover { filter: brightness(.95); }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .lg-coll { padding-left: 16px; padding-right: 16px; }
    #shopify-section-{{ section.id }} .lg-coll__heading { font-size: 24px; margin-bottom: 10px; max-width: 320px; }
    #shopify-section-{{ section.id }} .lg-coll__sub { font-size: 14px; margin-bottom: 24px; }
    #shopify-section-{{ section.id }} .lg-coll__grid { grid-template-columns: minmax(0, 400px); gap: 20px; }
    #shopify-section-{{ section.id }} .lg-coll__card { padding: 12px 12px 16px; border-radius: 22px; }
    #shopify-section-{{ section.id }} .lg-coll__badge { font-size: 11px; padding: 4px 10px; }
    #shopify-section-{{ section.id }} .lg-coll__reviews { font-size: 13px; }
    #shopify-section-{{ section.id }} .lg-coll__title { font-size: 19px; }
    #shopify-section-{{ section.id }} .lg-coll__meta { font-size: 14px; }
    #shopify-section-{{ section.id }} .lg-coll__now { font-size: 20px; }
    #shopify-section-{{ section.id }} .lg-coll__was { font-size: 13px; }
    #shopify-section-{{ section.id }} .lg-coll__save { font-size: 12px; }
    #shopify-section-{{ section.id }} .lg-coll__btn { min-height: 46px; font-size: 14px; }
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .lg-coll { padding-top: {{ section.settings.padding_top_mobile }}px; padding-bottom: {{ section.settings.padding_bottom_mobile }}px; }
  }
</style>

{% schema %}
{
  "name": "Logam Collection",
  "tag": "section",
  "class": "section--logam-collection",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore the Happy Hanuman Collection" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "text", "id": "details_label", "label": "Details button", "default": "Details" },
    { "type": "text", "id": "buy_label", "label": "Buy button", "default": "Buy now", "info": "Adds one copy and goes to checkout." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FDF3EC" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#14201A" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#D9692E" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top — desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom — desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top — mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom — mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "checkbox", "id": "badge_filled", "label": "Orange badge", "default": false },
        { "type": "text", "id": "reviews", "label": "Reviews text", "info": "e.g. (42 reviews). Leave blank to hide the stars." },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "subtitle", "label": "Details line", "default": "Archival Hardcover • 120+ Pages • Gold Foil Embellished" }
      ]
    }
  ],
  "presets": [
    { "name": "Logam Collection", "blocks": [ { "type": "product" } ] }
  ]
}
{% endschema %}
