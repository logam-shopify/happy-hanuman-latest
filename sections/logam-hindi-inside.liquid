{%- comment -%} fb_*: theme-asset images shown while the matching image setting is empty {%- endcomment -%}
{%- render 'logam-book-inside', hi: true, fb_photos: 'hh-hi-inside-1-guidance-page.jpg,hh-inside-illustration-with-hindi-page.jpg,hh-hi-inside-3-children-with-hanuman.jpg,hh-inside-art-closeup.jpg' -%}

{% schema %}
{
  "name": "Logam-hindi Inside Book",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small text",
      "default": "अंदर देखें"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "किताब के अंदर"
    },
    {
      "type": "text",
      "id": "sub",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "fallback_count",
      "label": "Product images to show when no photos are added",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 5
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image shape (mobile)",
      "options": [
        {
          "value": "1",
          "label": "Square"
        },
        {
          "value": "0.8",
          "label": "Portrait 4:5"
        },
        {
          "value": "0.75",
          "label": "Portrait 3:4"
        },
        {
          "value": "0.667",
          "label": "Tall 2:3"
        }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "ratio_d",
      "label": "Image shape (desktop)",
      "options": [
        {
          "value": "1",
          "label": "Square"
        },
        {
          "value": "0.8",
          "label": "Portrait 4:5"
        },
        {
          "value": "0.75",
          "label": "Portrait 3:4"
        },
        {
          "value": "0.667",
          "label": "Tall 2:3"
        }
      ],
      "default": "0.75"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#FFF8EE"
    },
    {
      "type": "range",
      "id": "pt_m",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "pb_m",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logam-hindi Inside Book"
    }
  ]
}
{% endschema %}
