{%- render 'logam-book-stats' -%}

{% schema %}
{
  "name": "Logam-English Stats",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Record photo"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small text",
      "default": "Guinness World Record holder"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "30,303 books signed in 30 hours"
    },
    {
      "type": "text",
      "id": "sub",
      "label": "Text",
      "default": "Surat, Gujarat · 3 December 2024 · 1,00,000+ readers"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#2B1A0E"
    },
    {
      "type": "range",
      "id": "pt_m",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "pb_m",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Logam-English Stats"
    }
  ]
}
{% endschema %}
