{%- comment -%} Bulk order / Free demo: "How it works". Photo + numbered steps (numbers come from the block order). {%- endcomment -%}
{%- render 'logam-hindi-assets' -%}
{{ 'logam-bulk-content.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #lh-{{ section.id }} { --lh-bg: {{ section.settings.bg }}; --lh-pt-m: {{ section.settings.pt_m }}px; --lh-pb-m: {{ section.settings.pb_m }}px; --lh-pt: {{ section.settings.pt }}px; --lh-pb: {{ section.settings.pb }}px; }
{%- endstyle -%}
<section id="lh-{{ section.id }}" class="lh lb-how">
  <div class="lh__in">
    {%- render 'logam-hindi-heading', eyebrow: section.settings.eyebrow, title: section.settings.title, sub: section.settings.sub -%}
    <div class="lb-how__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 1200px) 532px, (min-width: 750px) 50vw, calc(100vw - 32px)', loading: 'lazy', alt: section.settings.image_alt }}
      {%- else -%}
        <img src="{{ 'lb-bk-backpuja.jpg' | asset_url }}" width="1024" height="1024" alt="{{ section.settings.image_alt | escape }}" loading="lazy">
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ol class="lb-how__steps" role="list">
        {%- for block in section.blocks -%}
          <li class="lb-how__step" {{ block.shopify_attributes }}>
            <span class="lh-steps__n" aria-hidden="true">{{ forloop.index }}</span>
            <div>
              <h3>{{ block.settings.title }}</h3>
              {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Logam-Bulk How it works",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small text",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "From your logo to books in your hands"
    },
    {
      "type": "text",
      "id": "sub",
      "label": "Subheading"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Empty: shows the back-cover photo from the design. Cropped 4:3 on mobile, square on desktop."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description (alt text)",
      "default": "The back cover with space for your brand, slogan, number and address"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#FFF8EE"
    },
    {
      "type": "range",
      "id": "pt_m",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "pb_m",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fill in your details"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Brand name, number and logo. It takes 2 minutes."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logam-Bulk How it works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Fill in your details",
            "text": "Brand name, number and logo. It takes 2 minutes."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Pay 50% advance",
            "text": "Or start with one free demo book: you pay only ₹69 delivery."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Approve your design on WhatsApp",
            "text": "We send it within 24 hours and make changes if you need them."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "We print and deliver",
            "text": "Pay the other 50% before dispatch. Delivery is free across India."
          }
        }
      ]
    }
  ]
}
{% endschema %}
