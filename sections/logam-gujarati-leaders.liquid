            "role": "એક્ટર અને ડિરેક્ટર, હનુમાન ભક્ત"
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "સારાં ચિત્રો સારું ચરિત્ર બનાવી શકે છે. આ કામથી મને ખૂબ આનંદ છે.",
            "name": "પૂજ્ય મોરારિબાપુ"
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "હનુમાનજી પર આટલું ઊંડું અને ઉત્તમ કામ મેં ક્યારેય જોયું નથી.",
            "name": "પૂજ્ય હરિપ્રકાશ શાસ્ત્રી",
            "role": "સાળંગપુર ધામ"
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "ખૂબ સુંદર કામ છે. બાળકો અને યુવાનો માટે હનુમાનજી પર આનાથી વધુ રસપ્રદ પુસ્તક મેં જોયું નથી.",
            "name": "અક્ષત ગુપ્તા",
            "role": "લેખક"
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "આ પુસ્તક દરેકના હાથમાં પહોંચવું જોઈએ. રજૂઆત ખૂબ રસપ્રદ છે.",
            "name": "જય વસાવડા",
            "role": "લેખક"
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "આશિષ, ભગવાન તારી સાથે છે. ખૂબ સરસ કામ, હવે પુસ્તક પૂરું થયું. આ કામમાં ખુદ ભગવાન તારી સાથે છે.",
            "name": "પદ્મભૂષણ સ્વામી સચ્ચિદાનંદ"
          }
        }
      ]
    }
  ]
