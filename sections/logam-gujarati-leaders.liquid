{%- comment -%} fb_*: theme-asset images shown while the matching image setting is empty {%- endcomment -%}
{%- render 'logam-book-leaders', hi: true, fb_photos: 'hh-leader-1-anupam-kher.jpg,hh-leader-2-morari-bapu.jpg,hh-leader-3-hari-prakash-shastri.jpg,hh-leader-4-akshat-gupta.jpg,hh-leader-5-jay-vasavada.jpg,hh-leader-6-swami-sachidananda.jpg' -%}

{% schema %}
{
  "name": "Logam-Gujarati Leaders",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small text",
      "default": "આશીર્વાદ"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
