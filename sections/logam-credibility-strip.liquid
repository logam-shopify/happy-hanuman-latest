<div class="hh-cred" style="--hh-cred-bg: {{ section.settings.bg_color }}; --hh-cred-fg: {{ section.settings.text_color }}; --hh-cred-accent: {{ section.settings.accent_color }}; --hh-cred-muted: {{ section.settings.muted_color }};">
  {%- if section.blocks.size > 0 -%}
    <ul class="hh-cred__stats" role="list">
      {%- for block in section.blocks -%}
        <li class="hh-cred__stat" {{ block.shopify_attributes }}>
          {%- if block.settings.stat_value != blank -%}
            <span class="hh-cred__value">{{ block.settings.stat_value }}</span>
          {%- endif -%}
          {%- if block.settings.stat_label != blank -%}
            <span class="hh-cred__label">{{ block.settings.stat_label }}</span>
          {%- endif -%}
          {%- if block.settings.stat_desc != blank -%}
            <span class="hh-cred__desc">{{ block.settings.stat_desc }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

<style>
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} .section--credibility,
  #shopify-section-{{ section.id }} .hh-cred {
    background: var(--hh-cred-bg) !important;
    color: var(--hh-cred-fg);
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .hh-cred__stats {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
  }
  #shopify-section-{{ section.id }} .hh-cred__stat {
    display: flex;
    flex-direction: column;
    text-align: left;
    background: var(--hh-cred-bg) !important;
  }
  #shopify-section-{{ section.id }} .hh-cred__value {
    font-size: 32px;
    font-weight: 500;
    line-height: 1.2;
  }
  #shopify-section-{{ section.id }} .hh-cred__label {
    margin: 6px 0 8px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: .02em;
    text-transform: uppercase;
    color: var(--hh-cred-accent);
  }
  #shopify-section-{{ section.id }} .hh-cred__desc {
    font-size: 16px;
    line-height: 1.45;
  }
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .hh-cred__stats { grid-template-columns: 1fr 1fr; gap: 16px; }
    #shopify-section-{{ section.id }} .hh-cred__stat {
      padding: 20px 18px;
      border: 1px solid #e8e8e8;
      border-radius: 14px;
    }
    #shopify-section-{{ section.id }} .hh-cred__value { font-size: 26px; }
    #shopify-section-{{ section.id }} .hh-cred__label { margin: 2px 0 8px; font-size: 12px; font-weight: 600; }
    #shopify-section-{{ section.id }} .hh-cred__desc { font-size: 14px; color: var(--hh-cred-muted); }
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .hh-cred { padding-top: {{ section.settings.padding_top_mobile }}px; padding-bottom: {{ section.settings.padding_bottom_mobile }}px; }
  }
</style>

{% schema %}
{
  "name": "Logam Credibility Strip",
  "tag": "section",
  "class": "section--credibility",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1A1A1A" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#E07A2F" },
    { "type": "color", "id": "muted_color", "label": "Description (mobile)", "default": "#6B6B6B" },
    { "type": "range", "id": "padding_top", "label": "Padding top — desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom — desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top — mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom — mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "stat_value", "label": "Value", "default": "30,303" },
        { "type": "text", "id": "stat_label", "label": "Label", "default": "World record holder" },
        { "type": "text", "id": "stat_desc", "label": "Description", "default": "Books signed in 30 continuous hours" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Logam Credibility Strip", "blocks": [ { "type": "stat" } ] }
  ]
}
{% endschema %}
