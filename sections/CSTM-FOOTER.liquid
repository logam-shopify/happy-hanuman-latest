{% comment %}
  Custom Dynamic Footer Section
{% endcomment %}

<footer class="footer bg-white border-t">
  <div class="container mx-auto px-6 py-10 grid grid-cols-1 md:grid-cols-4 gap-8">

    <!-- Logo & About -->
    <div>
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | image_url }}" alt="logo" class="mb-4 w-32">
      {% endif %}
      <p class="text-gray-700 mb-2">{{ section.settings.about_text }}</p>
      {% if section.settings.phone != blank %}
        <p class="font-bold text-orange-600 mb-2">{{ section.settings.phone }}</p>
      {% endif %}
      {% if section.settings.email != blank %}
        <p class="text-gray-700">{{ section.settings.email }}</p>
      {% endif %}
    </div>

    <!-- Explore Links -->
    <div>
      <h3 class="font-bold text-orange-600 mb-4">{{ section.settings.explore_title }}</h3>
      <ul class="space-y-2">
        {% for link in section.blocks %}
          {% if link.type == 'explore' %}
            <li><a href="{{ link.settings.url }}" class="hover:text-orange-600">{{ link.settings.text }}</a></li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>

    <!-- Useful Links -->
    <div>
      <h3 class="font-bold text-orange-600 mb-4">{{ section.settings.useful_title }}</h3>
      <ul class="space-y-2">
        {% for link in section.blocks %}
          {% if link.type == 'useful' %}
            <li><a href="{{ link.settings.url }}" class="hover:text-orange-600">{{ link.settings.text }}</a></li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>

    <!-- Newsletter -->
    <div>
      <h3 class="font-bold text-orange-600 mb-4">{{ section.settings.newsletter_title }}</h3>
      <p class="text-gray-700 mb-4">{{ section.settings.newsletter_text }}</p>
      {% form 'customer' %}
        <input type="email" name="contact[email]" placeholder="Email Id" class="border p-2 w-full mb-3 rounded">
        <button type="submit" class="bg-orange-600 text-white px-4 py-2 rounded">Subscribe</button>
      {% endform %}
      <div class="flex space-x-4 mt-4">
        {% if section.settings.youtube != blank %}
          <a href="{{ section.settings.youtube }}" target="_blank">📺</a>
        {% endif %}
        {% if section.settings.instagram != blank %}
          <a href="{{ section.settings.instagram }}" target="_blank">📷</a>
        {% endif %}
        {% if section.settings.facebook != blank %}
          <a href="{{ section.settings.facebook }}" target="_blank">👍</a>
        {% endif %}
      </div>
    </div>

  </div>

  <div class="border-t py-4 text-center text-gray-600 text-sm">
    © {{ 'now' | date: "%Y" }} {{ shop.name }}, All Rights Reserved
    <div class="mt-2">
      <img src="https://cdn.shopify.com/s/files/1/0533/2089/files/payment-icons.png" alt="payment methods" class="mx-auto">
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Custom Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "about_text",
      "label": "About Text",
      "default": "Devotee, and storyteller whose work bridges tradition and modern life."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email"
    },
    {
      "type": "text",
      "id": "explore_title",
      "label": "Explore Title",
      "default": "Explore"
    },
    {
      "type": "text",
      "id": "useful_title",
      "label": "Useful Links Title",
      "default": "Useful Links"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter Title",
      "default": "Stay in the know"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter Description",
      "default": "Devotee, and storyteller whose work bridges tradition and modern life."
    },
    {
      "type": "url",
      "id": "youtube",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "Facebook URL"
    }
  ],
  "blocks": [
    {
      "type": "explore",
      "name": "Explore Link",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Link Text"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        }
      ]
    },
    {
      "type": "useful",
      "name": "Useful Link",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Link Text"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Footer"
    }
  ]
}
{% endschema %}
