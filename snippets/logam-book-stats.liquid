{%- comment -%} Shared by the Logam-hindi and Logam-English sections: layout only, all text comes from section settings. {%- endcomment -%}
{%- render 'logam-hindi-assets' -%}
{%- style -%}
  #lh-{{ section.id }} { --lh-bg: {{ section.settings.bg }}; --lh-pt-m: {{ section.settings.pt_m }}px; --lh-pb-m: {{ section.settings.pb_m }}px; --lh-pt: {{ section.settings.pt }}px; --lh-pb: {{ section.settings.pb }}px; }
{%- endstyle -%}
<section id="lh-{{ section.id }}" class="lh{% if hi %} lh--hi{% endif %} lh--dark lh-stats">
  <div class="lh__in lh-stats__in">
    {%- if section.settings.image != blank -%}
      <div class="lh-stats__img">{{ section.settings.image | image_url: width: 480 | image_tag: widths: '160, 240, 480', sizes: '(min-width: 750px) 220px, 80px', loading: 'lazy', alt: section.settings.image.alt }}</div>
    {%- elsif request.design_mode -%}
      <div class="lh-stats__img lh-stats__img--empty">{{ 'image' | placeholder_svg_tag }}</div>
    {%- endif -%}
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="lh-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.title != blank -%}<h2>{{ section.settings.title }}</h2>{%- endif -%}
      {%- if section.settings.sub != blank -%}<p>{{ section.settings.sub }}</p>{%- endif -%}
    </div>
  </div>
</section>
