{%- comment -%} Shared by the Logam-hindi and Logam-English sections: layout only, all text comes from section settings. {%- endcomment -%}
{%- render 'logam-hindi-assets' -%}
{%- style -%}
  #lh-{{ section.id }} { --lh-bg: {{ section.settings.page_bg }}; --lh-band: {{ section.settings.bg }}; --lh-gap-m: {{ section.settings.gap_m }}px; --lh-gap: {{ section.settings.gap }}px; --lh-pt-m: {{ section.settings.pt_m }}px; --lh-pb-m: {{ section.settings.pb_m }}px; --lh-pt: {{ section.settings.pt }}px; --lh-pb: {{ section.settings.pb }}px; }
{%- endstyle -%}
<section id="lh-{{ section.id }}" class="lh{% if hi %} lh--hi{% endif %} lh--band lh-author">
  <div class="lh-band"><div class="lh__in">
    <div class="lh-author__card">
      <div class="lh-author__img">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 600 | image_tag: widths: '160, 300, 600', sizes: '(min-width: 750px) 300px, 76px', loading: 'lazy', alt: section.settings.name | escape }}
        {%- elsif fb_image != blank -%}
          <img src="{{ fb_image | asset_url }}" alt="{{ section.settings.name | escape }}" loading="lazy">
        {%- else -%}
          {{ 'image' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      <div class="lh-author__head">
        {%- if section.settings.eyebrow != blank -%}<p class="lh-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h3>{{ section.settings.name }}</h3>
        {%- if section.settings.role != blank -%}<p class="lh-author__role">{{ section.settings.role }}</p>{%- endif -%}
      </div>
      {%- if section.settings.bio != blank -%}<div class="lh-author__bio">{{ section.settings.bio }}</div>{%- endif -%}
    </div>
  </div></div>
</section>
