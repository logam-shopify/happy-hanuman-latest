{%- comment -%} Shared by the Logam-hindi and Logam-English sections: layout only, all text comes from section settings. {%- endcomment -%}
{%- render 'logam-hindi-assets' -%}
{%- style -%}
  #lh-{{ section.id }} { --lh-bg: {{ section.settings.bg }}; --lh-pt-m: {{ section.settings.pt_m }}px; --lh-pb-m: {{ section.settings.pb_m }}px; --lh-pt: {{ section.settings.pt }}px; --lh-pb: {{ section.settings.pb }}px; }
{%- endstyle -%}
<section id="lh-{{ section.id }}" class="lh{% if hi %} lh--hi{% endif %} lh-get">
  <div class="lh__in">
    {%- render 'logam-hindi-heading', eyebrow: section.settings.eyebrow, title: section.settings.title, sub: section.settings.sub -%}
    <div class="lh-get__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy' }}
      {%- elsif request.design_mode -%}
        <div class="lh-ph-empty">{{ 'image' | placeholder_svg_tag }}</div>
      {%- endif -%}
    </div>
    <div>
      <ul class="lh-check">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><span>{{ block.settings.text }}</span></li>
        {%- endfor -%}
      </ul>
      {%- render 'logam-book-upsell', product: section.settings.upsell, note: section.settings.upsell_note, label: section.settings.upsell_label -%}
    </div>
  </div>
</section>
