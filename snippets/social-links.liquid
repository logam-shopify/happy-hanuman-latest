{%- comment -%}
  Labelled social links. Added by EDD (Aug 2026).

  Usage: {% render 'social-links', links: block.settings.social_links, label: block.settings.social_label %}

  WHY LABELLED, NOT A ROW OF GLYPHS
  Happy Hanuman runs five Instagram accounts. Five identical Instagram icons in a row tell
  a visitor nothing — they cannot pick the one they want, so they click none. Each link
  carries its own name and the icon only says which platform it is. One of the accounts
  (Garbhyatra) is a different brand entirely, which makes naming them mandatory rather
  than nice to have.

  FORMAT — one link per line, `Label | URL`:
      Happy Hanuman | https://www.youtube.com/@HappyHanumanAuthor
      Happy Hanuman | https://www.instagram.com/happyhanuman_author

  The platform icon is inferred from the URL, so adding an account later is one line in
  Theme settings with nothing to wire up. Lines without a `|` or without a URL are skipped
  rather than rendered broken.

  Note on the URLs: the `?igsh=...` share tokens Instagram appends were stripped. They are
  per-share tracking parameters, not part of the address, and they go stale.
{%- endcomment -%}

{%- if links != blank -%}
  <div class="social-links">
    {%- if label != blank -%}
      <p class="social-links__label">{{ label }}</p>
    {%- endif -%}

    <ul class="social-links__list" role="list">
      {%- assign rows = links | newline_to_br | split: '<br />' -%}
      {%- for row in rows -%}
        {%- assign parts = row | strip | split: '|' -%}
        {%- if parts.size < 2 -%}{%- continue -%}{%- endif -%}
        {%- assign link_label = parts[0] | strip -%}
        {%- assign link_url = parts[1] | strip -%}
        {%- if link_url == blank -%}{%- continue -%}{%- endif -%}

        {%- liquid
          assign platform = 'link'
          if link_url contains 'instagram.com'
            assign platform = 'instagram'
          elsif link_url contains 'youtube.com' or link_url contains 'youtu.be'
            assign platform = 'youtube'
          elsif link_url contains 'facebook.com' or link_url contains 'fb.com'
            assign platform = 'facebook'
          elsif link_url contains 'x.com' or link_url contains 'twitter.com'
            assign platform = 'twitter'
          elsif link_url contains 'wa.me' or link_url contains 'whatsapp.com'
            assign platform = 'whatsapp'
          endif
        -%}

        <li class="social-links__item">
          <a class="social-links__link" href="{{ link_url }}" target="_blank" rel="noopener">
            <span class="social-links__icon social-links__icon--{{ platform }}" aria-hidden="true">
              {%- case platform -%}
                {%- when 'instagram' -%}
                  <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2.2c3 0 3.4.01 4.6.07 1.1.05 1.8.23 2.4.5.6.3 1 .6 1.5 1.2.5.5.8.9 1.2 1.5.27.6.45 1.3.5 2.4.06 1.2.07 1.6.07 4.6s-.01 3.4-.07 4.6c-.05 1.1-.23 1.8-.5 2.4-.3.6-.6 1-1.2 1.5-.5.5-.9.8-1.5 1.2-.6.27-1.3.45-2.4.5-1.2.06-1.6.07-4.6.07s-3.4-.01-4.6-.07c-1.1-.05-1.8-.23-2.4-.5-.6-.3-1-.6-1.5-1.2-.5-.5-.8-.9-1.2-1.5-.27-.6-.45-1.3-.5-2.4C2.21 15.4 2.2 15 2.2 12s.01-3.4.07-4.6c.05-1.1.23-1.8.5-2.4.3-.6.6-1 1.2-1.5.5-.5.9-.8 1.5-1.2.6-.27 1.3-.45 2.4-.5C8.6 2.21 9 2.2 12 2.2Zm0 2.2c-3 0-3.3.01-4.5.07-.9.04-1.4.2-1.7.33-.4.15-.7.33-1 .66-.33.33-.51.6-.66 1-.13.3-.29.8-.33 1.7-.06 1.2-.07 1.5-.07 4.5s.01 3.3.07 4.5c.04.9.2 1.4.33 1.7.15.4.33.7.66 1 .33.33.6.51 1 .66.3.13.8.29 1.7.33 1.2.06 1.5.07 4.5.07s3.3-.01 4.5-.07c.9-.04 1.4-.2 1.7-.33.4-.15.7-.33 1-.66.33-.33.51-.6.66-1 .13-.3.29-.8.33-1.7.06-1.2.07-1.5.07-4.5s-.01-3.3-.07-4.5c-.04-.9-.2-1.4-.33-1.7-.15-.4-.33-.7-.66-1-.33-.33-.6-.51-1-.66-.3-.13-.8-.29-1.7-.33-1.2-.06-1.5-.07-4.5-.07Zm0 2.7a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8Zm0 2.2a2.7 2.7 0 1 0 0 5.4 2.7 2.7 0 0 0 0-5.4Zm5.2-3.1a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2Z"/></svg>
                {%- when 'youtube' -%}
                  <svg viewBox="0 0 24 24"><path fill="currentColor" d="M23.5 6.2a3.1 3.1 0 0 0-2.2-2.2C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.3.5A3.1 3.1 0 0 0 .5 6.2 37.5 37.5 0 0 0 0 12a37.5 37.5 0 0 0 .5 5.8 3.1 3.1 0 0 0 2.2 2.2C4.5 20.5 12 20.5 12 20.5s7.5 0 9.3-.5a3.1 3.1 0 0 0 2.2-2.2A37.5 37.5 0 0 0 24 12a37.5 37.5 0 0 0-.5-5.8ZM9.8 15.5v-7l6.2 3.5-6.2 3.5Z"/></svg>
                {%- when 'facebook' -%}
                  <svg viewBox="0 0 24 24"><path fill="currentColor" d="M14 8h3V4h-3c-2.2 0-4 1.8-4 4v2H7v4h3v6h4v-6h3l1-4h-4V8c0-.6.4-1 1-1Z"/></svg>
                {%- when 'twitter' -%}
                  <svg viewBox="0 0 24 24"><path fill="currentColor" d="M18.9 3H22l-8 9.2 9.4 8.8H16l-6-5.8-6.9 7.8H2.9l7-8L1 3h6l5.4 5.4L18.9 3Zm-2 16h2.2L7.2 5H5l11.9 14Z"/></svg>
                {%- when 'whatsapp' -%}
                  <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5 0-.9.2-3.1-.7-2.6-1.1-4.2-3.8-4.4-4-.1-.2-1-1.4-1-2.6s.6-1.8.9-2c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2 0 .4-.1.5l-.4.5c-.1.2-.3.3-.1.6.1.3.7 1.2 1.5 1.9 1 .9 1.8 1.2 2.1 1.3.2.1.4.1.6-.1l.7-.8c.2-.2.3-.2.6-.1l1.8.9c.3.1.5.2.5.4v1Z"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7L11.5 6.8M14 10a4 4 0 0 0-5.7 0l-3 3A4 4 0 0 0 11 18.7l1.4-1.4"/></svg>
              {%- endcase -%}
            </span>
            <span class="social-links__name">{{ link_label }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>

  {%- style -%}
    .social-links__label {
      margin: 0 0 10px;
      font-weight: 600;
    }
    .social-links__list {
      display: flex;
      flex-direction: column;
      gap: 9px;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .social-links__item { margin: 0; }
    .social-links__link {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: inherit;
    }
    .social-links__link:hover .social-links__name,
    .social-links__link:focus-visible .social-links__name {
      text-decoration: underline;
    }
    .social-links__icon {
      flex: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      color: #fff;
      background: #6B5744;
    }
    .social-links__icon svg { width: 17px; height: 17px; display: block; }
    /* Brand fills. The old markup declared .is-fb and .is-x only, and the rule above
       them was an empty selector with a stray closing brace — YouTube and Instagram
       had no fill at all. */
    .social-links__icon--instagram {
      background: radial-gradient(circle at 30% 107%, #FDF497 0%, #FD5949 45%, #D6249F 60%, #285AEB 90%);
    }
    .social-links__icon--youtube  { background: #FF0000; }
    .social-links__icon--facebook { background: #1877F2; }
    .social-links__icon--twitter  { background: #000; }
    .social-links__icon--whatsapp { background: #25D366; }
    .social-links__name {
      font-size: 14px;
      line-height: 1.35;
    }

    /* On a phone the row is only as tall as the 28px icon, which is under the 44px
       minimum comfortable tap target — six of them stacked is six chances to miss.
       Grow the hit area rather than the icon, and pull the gap in so the list does
       not get taller overall. */
    @media screen and (max-width: 767px) {
      .social-links__list { gap: 2px; }
      .social-links__link { min-height: 44px; }
    }
  {%- endstyle -%}
{%- endif -%}
