{%- comment -%}
  Floating WhatsApp contact button.
  Rendered once from layout/theme.liquid. All values come from Theme settings > WhatsApp.
{%- endcomment -%}

{%- liquid
  assign wa_number = settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
-%}

{%- if settings.whatsapp_enabled and wa_number != blank -%}
  {%- capture wa_message -%}
    {%- if settings.whatsapp_message != blank -%}{{ settings.whatsapp_message }}{%- else -%}Hi! I have a question about {{ shop.name }}.{%- endif -%}
  {%- endcapture -%}

  <a
    class="hh-whatsapp"
    href="https://wa.me/{{ wa_number }}?text={{ wa_message | strip | url_encode }}"
    target="_blank"
    rel="noopener"
    aria-label="Chat with us on WhatsApp"
  >
    <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M16.04 3C9.4 3 4 8.4 4 15.04c0 2.12.55 4.19 1.6 6.02L4 29l8.13-1.55a12.02 12.02 0 0 0 3.91.65h.01C22.68 28.1 28.08 22.7 28.08 16.06 28.08 8.4 22.68 3 16.04 3zm0 22.1h-.01c-1.2 0-2.38-.24-3.48-.72l-.25-.11-4.82.92.93-4.7-.16-.26a9.96 9.96 0 0 1-1.53-5.3c0-5.52 4.5-10.01 10.03-10.01 5.52 0 10.01 4.5 10.01 10.02 0 5.52-4.5 10.01-10.02 10.01zm5.5-7.5c-.3-.15-1.78-.88-2.06-.98-.28-.1-.48-.15-.68.15s-.78.98-.96 1.18c-.18.2-.35.22-.65.07-.3-.15-1.27-.47-2.42-1.49-.9-.8-1.5-1.78-1.68-2.08-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.68-1.63-.93-2.23-.24-.58-.49-.5-.68-.51h-.58c-.2 0-.53.07-.8.38-.28.3-1.05 1.03-1.05 2.5s1.08 2.9 1.23 3.1c.15.2 2.12 3.24 5.15 4.54.72.31 1.28.5 1.72.64.72.23 1.38.2 1.9.12.58-.09 1.78-.73 2.03-1.43.25-.7.25-1.3.18-1.43-.07-.13-.27-.2-.57-.35z"/>
    </svg>
    {%- if settings.whatsapp_label != blank -%}
      <span class="hh-whatsapp__label">{{ settings.whatsapp_label }}</span>
    {%- endif -%}
  </a>

  <style>
    .hh-whatsapp {
      position: fixed;
      right: 18px;
      bottom: 40px;
      z-index: 900;
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 13px 16px;
      border-radius: 999px;
      background: #25D366;
      color: #fff;
      text-decoration: none;
      box-shadow: 0 6px 18px rgba(0, 0, 0, .22);
      transition: transform .18s ease, box-shadow .18s ease;
    }
    .hh-whatsapp:hover,
    .hh-whatsapp:focus-visible {
      color: #fff;
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(0, 0, 0, .28);
    }
    .hh-whatsapp__label {
      font-size: 15px;
      font-weight: 600;
      line-height: 1;
      white-space: nowrap;
    }
    /* Icon-only on small screens so it never covers content or the cart bar. */
    @media screen and (max-width: 740px) {
      .hh-whatsapp {
        right: 14px;
        bottom: 36px;
        padding: 14px;
      }
      .hh-whatsapp__label { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      .hh-whatsapp { transition: none; }
      .hh-whatsapp:hover { transform: none; }
    }
  </style>
{%- endif -%}
